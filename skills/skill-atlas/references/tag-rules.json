{
  "version": 1,
  "about": "One entry per tag. A tag is attached to a step (and rolled up to its skill and phase) when any pattern matches a line of that step, except that a match negated earlier in its own clause (never, not, no, nor, without, avoid, don't, doesn't, won't, cannot or can't within the 60 characters before it in the same sentence) is not evidence; set \"negatable\": false on a rule whose matches count even when negated. Patterns are JavaScript regular expressions, matched case-insensitively. Edit, add or delete entries freely; ids must look like <category>.<slug> with category one of input, output, tool, human.",
  "tags": [
    { "id": "input.arguments", "category": "input", "label": "Arguments",
      "patterns": ["\\$ARGUMENTS\\b", "(?<![\\w$])\\$\\{?[0-9]\\}?(?![\\d.,]|\\s*(per|each)\\b)", "\\b(caller|user) (supplies|provides|passes|gives)\\b", "\\btakes? (an? |the )?(optional )?(argument|path|url|topic|target)\\b"] },
    { "id": "input.files", "category": "input", "label": "Reads files",
      "patterns": ["\\b(read|open|load|parse|inspect|scan|consult)s?\\b(?:\\s+[\\w./`-]+){0,3}?\\s+(files?|director(y|ies)|folders?|codebase|repo(sitory)?|sources?|configs?|specs?)\\b", "\\b(Read|Glob|Grep) tool\\b", "@[\\w./-]+\\.(md|json|ya?ml|ts|js|py)\\b"] },
    { "id": "input.git", "category": "input", "label": "Git history",
      "patterns": ["\\bgit (log|diff|show|status|blame|rev-parse)\\b", "\\bcommit (message|history)s?\\b", "\\b(read|review|examine)s?\\b(?:\\s+[\\w./`-]+){0,2}?\\s+(commit|diff)s?\\b"] },
    { "id": "input.web", "category": "input", "label": "Web and docs",
      "patterns": ["\\bWeb(Fetch|Search)\\b", "\\b(fetch|retrieve|search|browse)(es|ing)?\\b(?:\\s+[\\w./`-]+){0,3}?\\s+(urls?|web|pages?|docs|documentation|online)\\b"] },
    { "id": "input.service", "category": "input", "label": "External service",
      "patterns": ["\\bgh (api|issue (view|list)|pr (view|list|diff|checks)|run (view|list))\\b", "\\b(query|call|request)(s|ing)?\\b.{0,30}\\b(API|endpoint|database|service)\\b"] },

    { "id": "output.files", "category": "output", "label": "Writes files",
      "patterns": ["\\b(write|create|save|generate|update|edit|modify|add|emit)s?\\b(?:\\s+[\\w./`-]+){0,3}?\\s+(files?|documents?|reports?|specs?|records?|code|tests?)\\b", "\\b(Write|Edit|MultiEdit) tool\\b"] },
    { "id": "output.commit", "category": "output", "label": "Git commit",
      "patterns": ["\\bgit (commit|add|push|tag|merge|rebase)\\b", "\\b(make|create|add)s?\\b.{0,30}\\bcommits?\\b", "\\bcommit (the|your|its|every|all)\\b", "\\b(one|a) new commit\\b|\\bone commit (per|for|each)\\b|\\bnew commits\\b"] },
    { "id": "output.pull-request", "category": "output", "label": "PR or issue",
      "patterns": ["\\bgh (pr|issue) (create|merge|comment|edit|close|review)\\b", "\\b(open|create|merge|update)s?\\b.{0,20}\\b(pull request|PR|issue)\\b"] },
    { "id": "output.report", "category": "output", "label": "Report",
      "patterns": ["\\b(report|summari[sz]e|present)s?\\b(?:\\s+[\\w-]+){0,3}?\\s+(findings?|results?|summary|outcome|status|verdict)\\b", "^#+\\s*output( format)?\\b", "\\breturns? (the |a |its |your )?(findings?|results?|summary|outcome|verdict|report)\\b(?!\\s*[.(\\w])", "\\b(report|return)s? (it |them |this |that )?to the (user|caller)\\b"] },
    { "id": "output.external", "category": "output", "label": "External change",
      "patterns": ["\\b(deploy|publish|release)(s|es|ed|ing)?\\s+(to|the|it|your|a|an|this|that|its|them|changes|code|packages?)\\b", "\\bsend(s|ing)? (an? |the )?(email|message|notification)\\b", "\\bpost(s|ing)? (a |the )?(comment|reply|message|update)\\b", "\\b(npm publish|wrangler deploy|terraform apply|kubectl apply)\\b"] },

    { "id": "tool.shell", "category": "tool", "label": "Shell",
      "patterns": ["\\bBash\\b", "^(```|~~~)\\s*(bash|sh|shell|zsh|console)\\b", "\\brun(s|ning)? (the |this |a )?(command|script)\\b"] },
    { "id": "tool.git", "category": "tool", "label": "git",
      "patterns": ["\\bgit (add|am|apply|bisect|blame|branch|check-ignore|checkout|cherry-pick|clean|clone|commit|config|describe|diff|fetch|grep|init|log|ls-files|merge|mv|pull|push|rebase|reflog|remote|reset|restore|rev-list|rev-parse|revert|rm|show|stash|status|submodule|switch|tag|worktree)\\b"] },
    { "id": "tool.github", "category": "tool", "label": "GitHub CLI",
      "patterns": ["\\bgh (api|pr|issue|run|repo|release|workflow)\\b"] },
    { "id": "tool.edit", "category": "tool", "label": "File editing",
      "patterns": ["\\b(Edit|Write|MultiEdit|NotebookEdit)\\b(?= tool\\b|\\()", "\\bapply_patch\\b"] },
    { "id": "tool.search", "category": "tool", "label": "Code search",
      "patterns": ["\\b(Grep|Glob)\\b", "\\b(rg|ripgrep|grep -[a-zA-Z]+)\\b"] },
    { "id": "tool.web", "category": "tool", "label": "Web access",
      "patterns": ["\\bWeb(Fetch|Search)\\b", "\\bcurl (-|https?:|[\\\"']https?:|\\$)", "\\bweb search\\b"] },
    { "id": "tool.browser", "category": "tool", "label": "Browser",
      "patterns": ["\\b(playwright|puppeteer|chrome devtools|browser automation|headless browser)\\b", "\\b(navigate|screenshot|automate|drive|control)s?\\b.{0,30}\\bbrowser\\b"] },
    { "id": "tool.subagent", "category": "tool", "label": "Subagents",
      "patterns": ["\\bsub-?agents?\\b", "\\b(Task|Agent) tool\\b", "\\b(spawn|delegate to|launch)(s|ing)? (an? |the )?(fresh |separate |independent |new )?agent\\b", "^context:\\s*fork\\b"] },
    { "id": "tool.script", "category": "tool", "label": "Bundled script",
      "patterns": ["\\bscripts/[\\w./-]+\\.(py|sh|mjs|cjs|js|ts|rb)\\b"] },
    { "id": "tool.package-manager", "category": "tool", "label": "Package manager",
      "patterns": ["\\b(npm|npx|pnpm|yarn|bun|pip|pipx|uv|cargo|brew) (install|run|add|exec|test|ci|i|x|build)\\b", "\\bnpx [\\w@/-]+"] },

    { "id": "human.question", "category": "human", "label": "Asks the user",
      "patterns": ["\\bask(s|ing)? (the )?(user|human|boss|owner|developer|them)\\b(?! (to|for) )", "\\bAskUserQuestion\\b", "\\bclarif(y|ies|ying) (with|the (request|intent|requirements?))\\b", "\\b(ask|raise)s? (a |that |the )?(clarifying )?question\\b"] },
    { "id": "human.approval", "category": "human", "label": "Needs approval", "negatable": false,
      "patterns": ["\\b(user|human|owner|boss|explicit|their|maintainer)\\W+(\\w+\\W+){0,2}(approval|confirmation|permission|consent|sign-?off|go-ahead)\\b", "\\bconfirm(s|ing)? with (the )?(user|human|owner)\\b", "\\b(user|human|owner|boss) approves?\\b", "\\bask (the user|them) to (approve|confirm)\\b", "\\bask(s|ing)? (for |first for )?(approval|confirmation|permission)\\b", "\\bwait(s|ing)? for (the )?(user|human|approval|confirmation|go-ahead)\\b", "\\b(never|not|don't|do not)\\b.{0,40}\\bwithout (asking|approval|confirmation|permission)\\b", "\\bbefore (deleting|overwriting|publishing|deploying|pushing|sending)\\b.{0,40}\\b(ask|confirm)\\b"] },
    { "id": "human.choice", "category": "human", "label": "User decides",
      "patterns": ["\\b(user|human|owner|boss) (reviews?|decides?|chooses?|selects?|picks?)\\b", "\\bpresent(s|ing)?\\b.{0,40}\\b(options|choices|alternatives|for (review|approval|feedback))\\b", "\\blet (the user|them) (choose|decide|pick)\\b"] },
    { "id": "human.handoff", "category": "human", "label": "User acts",
      "patterns": ["\\b(the )?user (must|should|needs to|has to|will) (run|do|perform|sign in|log in|provide|install|open|paste|enter)\\b", "\\bask (the user|them) to (run|perform|sign|log|install|open|paste|enter|provide|add|create|fix|set|configure|restart)\\b", "\\bmanual(ly)? (step|action|intervention)\\b"] }
  ]
}
