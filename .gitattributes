# Reference assets (DR-015, DR-089) are byte-exact: keep LF on every
# checkout so raw imports and content assertions match the committed
# bytes on Windows too.
packages/ui/src/examples/slc-demo/* text eol=lf
packages/core/assets/playbook-sources/*.md text eol=lf
spex.yaml text eol=lf
spex.lock text eol=lf
specs/packages/*.md text eol=lf
# A skill's translation records the SHA-256 of its source's bytes
# (DR-245): keep LF on every checkout so a Windows clone reads the
# shipped translations as up to date.
skills/** text eol=lf
# A kept fault is a patch (DR-252): keep LF on every checkout so a patch
# and a guard's other files read on Windows as they were written. The
# digests do not need it; they are taken over LF text.
guards/** text eol=lf
