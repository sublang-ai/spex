  "nodes": [
    {
      "id": "ready",
      "kind": "state",
      "description": "Waiting for a caller to start a review.",
      "tags": [
        "playbook.parked"
      ]
    },
    {
      "id": "firstReview",
      "kind": "state",
      "role": "reviewer",
      "description": "Reviewer runs the first review round over the review scope.",
      "tags": [
        "playbook.busy"
      ]
    },
    {
      "id": "fixFindings",
      "kind": "state",
      "role": "coder",
      "description": "Coder accepts or rejects each of Reviewer's findings and commits any accepted fixes.",
      "tags": [
        "playbook.busy"
      ]
    },
    {
      "id": "reviewAfterFix",
      "kind": "state",
      "role": "reviewer",
      "description": "Reviewer runs the next review round over the cumulative committed state after a review-fix commit.",
      "tags": [
        "playbook.busy"
      ]
    },
    {
      "id": "reviewAfterRejection",
      "kind": "state",
      "role": "reviewer",
      "description": "Reviewer runs the next review round after Coder rejected every finding without a commit.",
      "tags": [
        "playbook.busy"
      ]
    },
    {
      "id": "awaitBossReply",
      "kind": "state",
      "description": "Waiting for Boss to answer the acting agent's question.",
      "tags": [
        "playbook.parked"
      ]
    },
    {
      "id": "failed",
      "kind": "state",
      "description": "REVIEW parked after a failure and waits for Boss to restart or resume it.",
      "tags": [
        "playbook.parked"
      ]
    },
    {
      "id": "done",
      "kind": "final",
      "description": "REVIEW completed: the review scope was evaluated at the returned revision and no unsettled findings remain.",
      "tags": []
    }
  ],
