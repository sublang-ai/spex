#. Separates names listed in one message
#. Separates names listed in one message
#. Separates names listed in one message
#. Separates names listed in one message
#: src/app-storage.ts
#: src/config.ts
#: src/service.ts
msgid ", "
msgstr "、"

#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#: src/config.ts
#: src/service.ts
#: src/session.ts
#: src/store.ts
msgid "; "
msgstr "；"

#. Clause of the role-coverage config error: the roles no binding names
#: src/config.ts
msgid "; missing {roles}"
msgstr "；缺少角色 {roles}"

#. Clause naming the fields a record may also carry
#: src/app-storage.ts
msgid "; optional {fields}"
msgstr "；可选字段 {fields}"

#. Tail of an adapter's requirement: the steps no install performs, in the runtime's own words
#: src/config.ts
msgid "; then: {steps}"
msgstr "；随后：{steps}"

#. Clause of the role-coverage config error: the bound roles the manifest never declares
#: src/config.ts
msgid "; unknown {roles}"
msgstr "；未知角色 {roles}"

#. A session's own title, quoted
#. A session's own title, quoted
#: src/service.ts
#: src/session.ts
msgid "“{title}”"
msgstr "“{title}”"

#. A stopped sync's message: a session is held elsewhere, named by its title
#: src/space.ts
msgid "“{title}” is in use"
msgstr "“{title}”正在使用中"

#. Stands in the branch's place where git names none
#: src/forge.ts
msgid "(unknown)"
msgstr "（未知）"

#. Guidance where an SSH remote refused access; {act} is the act that gives this machine access, already opening the sentence
#: src/space-git.ts
msgid "{act}; on a first connection, accept the host key in a terminal. Then Retry."
msgstr "{act}；首次连接时，请在终端中接受主机密钥。然后重试。"

#. Guidance where the remote refused access; {act} is the act that gives this machine access, already opening the sentence
#: src/space-git.ts
msgid "{act}. Then Retry."
msgstr "{act}。然后重试。"

#. A queue unit's detail: how many acts this side adds to the end
#: src/space.ts
msgid "{count, plural, one {# act appended} other {# acts appended}}"
msgstr "{count, plural, other {追加 # 条动作}}"

#. A queue unit side's detail: how many acts this side adds
#: src/space.ts
msgid "{count, plural, one {# act} other {# acts}}"
msgstr "{count, plural, other {# 条动作}}"

#. A queue unit's label; {name} is the project whose queue changed
#: src/space.ts
msgid "{count, plural, one {# change in {name}'s queue} other {# changes in {name}'s queue}}"
msgstr "{count, plural, other {{name} 的队列有 # 处更改}}"

#. A session unit's detail: how many turns it holds
#: src/space.ts
msgid "{count, plural, one {# turn} other {# turns}}"
msgstr "{count, plural, other {# 个轮次}}"

#. Adapter requirement; `described` is the runtime's own verdict and `npm install` the command to run
#: src/config.ts
msgid "{described} — bundled with Spex; reinstall the app, or run npm install in a checkout"
msgstr "{described} — 随 Spex 内置；请重新安装应用，或在源码检出目录中运行 npm install"

#. Adapter requirement; `described` is the runtime's own verdict and the npm line is the command to run
#: src/config.ts
msgid "{described} — install with: npm install -g {spec}{steps}"
msgstr "{described} — 安装方式：npm install -g {spec}{steps}"

#. Refusal on a damaged draft: the diagnostic already composed, then the way out
#: src/authoring.ts
msgid "{diagnostic}; delete the draft, or repair the file and restart Spex"
msgstr "{diagnostic}；删除草稿，或修复文件后重启 Spex"

#. Repair row: sessions name a folder no registered project holds
#: src/app-storage.ts
msgid "{directory} has no project on this device"
msgstr "{directory} 在本设备上没有对应的项目"

#. Refusal: the file moved under the write the reader asked for
#. Refusal: the file moved under the write the reader asked for
#: src/drafts.ts
#: src/specs.ts
msgid "{file} changed on disk since it was read"
msgstr "{file} 在读取之后已在磁盘上更改"

#. A storage fault as one line: the file, then the reason — itself a message
#: src/app-storage.ts
msgid "{file}: {reason}"
msgstr "{file}：{reason}"

#. Draft diagnostic: the transcript file, then the last record that still read
#: src/authoring.ts
msgid "{file}: damaged transcript after record {seq}"
msgstr "{file}：记录 {seq} 之后的对话记录已损坏"

#. A stopped transfer's message; {host} is the remote's host
#: src/space-git.ts
msgid "{host} refused this machine's access"
msgstr "{host} 拒绝了本机的访问"

#. Refusal: the id offered for a new draft is taken by a playbook already
#: src/authoring.ts
msgid "{id} is already a configured playbook or a built-in; pick another id"
msgstr "{id} 已是已配置的规程或内置规程；请换一个 id"

#. Refusal: a choice was sent for a unit the two sides agree on; {label} is the unit's own label
#: src/space.ts
msgid "{label} has no divergent change"
msgstr "{label} 两端没有分歧的更改"

#. Repair row: the project is registered, but nothing here holds it
#: src/app-storage.ts
msgid "{name} has no folder on this device"
msgstr "{name} 在本设备上没有文件夹"

#. A session another host is writing right now
#: src/service.ts
msgid "{name} is in use elsewhere"
msgstr "{name} 正在别处使用"

#. Refusal: another host holds this project's conversation
#: src/session.ts
msgid "{name} is in use elsewhere in {project}"
msgstr "{project} 中的 {name} 正在别处使用"

#. Refusal: one working turn per project
#: src/session.ts
msgid "{name} is still working in {project} — wait for it to finish, or abort it"
msgstr "{name} 仍在 {project} 中工作 — 请等待它完成，或中止它"

#. A session whose lease this host cannot read
#: src/service.ts
msgid "{name} ownership cannot be verified"
msgstr "{name} 的归属无法确认"

#. Refusal: a project already holds this folder
#: src/service.ts
msgid "{path} is already registered"
msgstr "{path} 已注册"

#. Config error: a role is bound to a malformed player id
#: src/config.ts
msgid "{path} is not a canonical player id"
msgstr "{path} 不是规范的 Player id"

#. Config error: a session player's id is malformed
#: src/config.ts
msgid "{path} is not a canonical player id (lowercase segments, dots optional)"
msgstr "{path} 不是规范的 Player id（小写片段，点号可选）"

#. Refusal: the path offered as a project is no directory on this device
#: src/service.ts
msgid "{path} is not a directory"
msgstr "{path} 不是目录"

#. Refusal: the explorer was asked to read something that is no file
#. Refusal: the path offered as a draft's source is no file on this device
#: src/authoring.ts
#: src/space.ts
msgid "{path} is not a file"
msgstr "{path} 不是文件"

#. Refusal: the explorer was asked to list something that is no folder
#: src/space.ts
msgid "{path} is not a folder"
msgstr "{path} 不是文件夹"

#. Refusal: the folder offered for rebinding is no git repository
#: src/service.ts
msgid "{path} is not the root of a git work tree"
msgstr "{path} 不是 git 工作树的根目录"

#. Spec notice; `intents/` is a directory name and stays as it is
#: src/specs.ts
msgid "{path} is shadowed by the same-named file under intents/"
msgstr "{path} 被 intents/ 下的同名文件遮蔽"

#. Config error: a role's binding is neither form
#: src/config.ts
msgid "{path} must be a player id or a binding block"
msgstr "{path} 必须是 Player id 或绑定块"

#. Config error: the value is neither an adapter's name nor a block of agent settings
#: src/config.ts
msgid "{path} must be an adapter shorthand or an agent block"
msgstr "{path} 必须是适配器简写或智能体块"

#. Config error; `effort` and `reasoningEffort` are the config file's own field names
#: src/config.ts
msgid "{path} must not set both effort and its legacy alias reasoningEffort"
msgstr "{path} 不能同时设置 effort 和它的旧别名 reasoningEffort"

#. Config error: the agent names no adapter to run on
#. Config error: the agent names no adapter to run on
#: src/config.ts
msgid "{path} must resolve an adapter"
msgstr "{path} 必须解析出一个适配器"

#. Config error: a role binds a player the roster does not define
#: src/config.ts
msgid "{path} names absent session player \"{playerId}\""
msgstr "{path} 指向不存在的会话 Player“{playerId}”"

#. Config error; the key and `adapter`/`permissions`/`instruction`/`workspace` are the config file's own field names
#: src/config.ts
msgid "{path}.{key} is not a role binding key: adapter, permissions, instruction and workspace belong to the session player"
msgstr "{path}.{key} 不是角色绑定的键：adapter、permissions、instruction 和 workspace 属于会话 Player"

#. Config error; `key` is the config file's own field name and `false` its own value
#: src/config.ts
msgid "{path}.{key} must be a string or false (the provider default)"
msgstr "{path}.{key} 必须是字符串或 false（服务商默认值）"

#. Config error; the effort, the adapter's name and the valid values are the runtime's own words
#: src/config.ts
msgid "{path}.effort \"{effort}\" is not supported by the \"{adapter}\" adapter (valid: {values})"
msgstr "{path}.effort“{effort}”不受“{adapter}”适配器支持（有效值：{values}）"

#. Config error; `fastMode` is the config file's own field name
#. Config error; `fastMode` is the config file's own field name
#: src/config.ts
msgid "{path}.fastMode must be a boolean"
msgstr "{path}.fastMode 必须是布尔值"

#. Config error; `permissions` is the config file's own field name
#: src/config.ts
msgid "{path}.permissions must be an object"
msgstr "{path}.permissions 必须是对象"

#. Config error; the policy's name and `allow`/`ask`/`deny` are the config file's own words
#: src/config.ts
msgid "{path}.permissions.{policy} must be allow, ask, or deny"
msgstr "{path}.permissions.{policy} 必须是 allow、ask 或 deny"

#. Config error; `permissions.mode`, `auto` and `bypass` are the config file's own words
#: src/config.ts
msgid "{path}.permissions.mode must be auto or bypass"
msgstr "{path}.permissions.mode 必须是 auto 或 bypass"

#. Config error; `permissions.writablePaths` is the config file's own field name
#: src/config.ts
msgid "{path}.permissions.writablePaths must be a string list"
msgstr "{path}.permissions.writablePaths 必须是字符串列表"

#. Config error; `player` is the config file's own field name
#: src/config.ts
msgid "{path}.player must name a canonical player id"
msgstr "{path}.player 必须指向规范的 Player id"

#. Config error; `profile`, `adapter`, `model`, `effort` and `permissions` are the config file's own field names
#: src/config.ts
msgid "{path}.profile is retired: agents carry their own adapter, model, effort, and permissions"
msgstr "{path}.profile 已废弃：每个智能体自带 adapter、model、effort 和 permissions"

#. Config migration failure; `profile` and `profiles` are the file's own retired field names
#: src/config-migrate.ts
msgid "{path}.profile names \"{name}\", which no profiles entry defines"
msgstr "{path}.profile 指向“{name}”，但 profiles 中没有该条目"

#. What blocks a Space operation: a playbook compile is running
#: src/service.ts
msgid "{playbookId} is compiling"
msgstr "{playbookId} 正在编译"

#. Refusal where the folder chosen for the example already holds files
#: src/forge.ts
msgid "{target} is not empty; the example seeds only a new or empty directory"
msgstr "{target} 不是空目录；示例只能填充新建或空的目录"

#. One settings drift; `who` is itself a message and `field` the config file's own field name
#: src/session.ts
msgid "{who}'s {field} changed"
msgstr "{who} 的 {field} 已更改"

#. Draft thread status line: the compile was canceled; the ◇ stays
#: src/authoring.ts
msgid "◇ Compile canceled"
msgstr "◇ 编译已取消"

#. Draft thread status line; {where} is the pipeline stage's name and the ◇ stays
#: src/authoring.ts
msgid "◇ Compile failed at {where} — sent to the agent"
msgstr "◇ 编译在 {where} 阶段失败 — 已发送给智能体"

#. Draft thread status line; {where} is the pipeline stage's name and the ◇ stays
#: src/authoring.ts
msgid "◇ Compile failed at {where} — three in a row; tell the agent how to proceed"
msgstr "◇ 编译在 {where} 阶段失败 — 已连续三次；请告诉智能体如何继续"

#. Draft thread status line; {where} is the pipeline stage's name and the ◇ stays
#: src/authoring.ts
msgid "◇ Compile failed at {where} — waiting for your queued message"
msgstr "◇ 编译在 {where} 阶段失败 — 正在等待你已排队的消息"

#. Draft thread status line: the toolchain's own guidance follows; the ◇ stays
#: src/authoring.ts
msgid "◇ Compile failed before the compiler ran: {reason}"
msgstr "◇ 编译器尚未运行，编译就失败了：{reason}"

#. Draft thread status line; the ◇ opens every one of them and stays
#: src/authoring.ts
msgid "◇ Compile interrupted when Spex closed"
msgstr "◇ 编译在 Spex 关闭时中断"

#. Draft thread status line: the agent asked for a compile that could not start; the ◇ stays
#: src/authoring.ts
msgid "◇ Compile skipped: {reason}"
msgstr "◇ 已跳过编译：{reason}"

#. Draft thread status line: the compile succeeded; the roles are the source's own names, the ◇ stays
#: src/authoring.ts
msgid "◇ Compiled — roles: {roles}"
msgstr "◇ 已编译 — 角色：{roles}"

#. Draft thread status line: the draft's agent started this compile; the ◇ stays
#: src/authoring.ts
msgid "◇ Compiling — asked by the agent"
msgstr "◇ 编译中 — 由智能体发起"

#. Draft thread status line: the Boss started this compile; the ◇ stays
#: src/authoring.ts
msgid "◇ Compiling — asked by you"
msgstr "◇ 编译中 — 由你发起"

#. Draft thread status line: a roster player now answers, named by its id; the ◇ stays
#: src/authoring.ts
msgid "◇ Now answering: {playerId} — the conversation so far was replayed to it"
msgstr "◇ 现在由 {playerId} 作答 — 此前的对话已重放给它"

#. Draft thread status line: the draft fell back to the Captain; the ◇ stays
#: src/authoring.ts
msgid "◇ Now answering: Captain — the conversation so far was replayed to it"
msgstr "◇ 现在由 Captain 作答 — 此前的对话已重放给它"

#. Draft thread status line: the agent's provider dropped the conversation; the ◇ stays
#: src/authoring.ts
msgid "◇ The provider rejected the resumed conversation — replaying it"
msgstr "◇ 服务商拒绝了续接的对话 — 正在重放"

#. Refusal: that draft's one compile is under way
#: src/authoring.ts
msgid "a compile is already running for {id}"
msgstr "{id} 已有编译在运行"

#. Refusal: one compile per playbook at a time
#: src/service.ts
msgid "a compile is already running for {playbookId}"
msgstr "{playbookId} 已有编译在运行"

#. Refusal: the draft's compile must end before this act
#: src/authoring.ts
msgid "a compile is running for {id}; cancel it first"
msgstr "{id} 正在编译；请先取消"

#. Refusal: work already sent cannot be reworded
#: src/service.ts
msgid "a dispatched intent's text is history"
msgstr "已派发的意图无法再修改文本"

#. A diagnostic's reason, read after the file it names
#: src/space.ts
msgid "a Git merge is pending; finish or abort it in a terminal before syncing"
msgstr "Git 合并尚未结束；请先在终端完成或中止，再进行同步"

#. Stands in for the title of a session that has none yet
#: src/service.ts
msgid "a new session"
msgstr "一个新会话"

#. Stands in for the title of a session that has none
#. Stands in for the title of a session that has none
#: src/service.ts
#: src/session.ts
msgid "a session"
msgstr "一个会话"

#. Refusal: another session of this project is opening
#: src/session.ts
msgid "a session is starting in {project} — wait a moment"
msgstr "{project} 中有会话正在启动 — 请稍候"

#. Refusal: a diff was asked of a unit that is read as a summary, not as text
#: src/space.ts
msgid "a session or queue offers no text diff"
msgstr "会话和队列不提供文本差异"

#. Refusal: this conversation is mid-turn
#. Refusal: this conversation is mid-turn
#: src/session.ts
msgid "a turn is already running in this session"
msgstr "此会话中已有轮次在运行"

#. Refusal: another send is already being admitted here
#: src/service.ts
msgid "a turn is being submitted in this session"
msgstr "此会话中已有一轮正在提交"

#. Storage diagnostic: an act follows the intent's removal
#: src/app-storage.ts
msgid "act targets removed intent {intentId}"
msgstr "动作指向已移除的意图 {intentId}"

#. Storage diagnostic: an act names an intent no queue act created
#: src/app-storage.ts
msgid "act targets unknown intent {intentId}"
msgstr "动作指向未知的意图 {intentId}"

#. Refusal: the home names no remote to sync with
#: src/space.ts
msgid "Add a remote first"
msgstr "请先添加远程仓库"

#. The act that gives access to an SSH remote, inside a sentence
#: src/space-git.ts
msgid "add this machine's SSH key to an account that can see it"
msgstr "把本机的 SSH 密钥添加到有权访问它的账户"

#. The act that gives access to an SSH remote, opening a sentence
#: src/space-git.ts
msgid "Add this machine's SSH key to an account that can see it"
msgstr "把本机的 SSH 密钥添加到有权访问它的账户"

#. Storage diagnostic: two projects claim one folder
#: src/app-storage.ts
msgid "ambiguous project path {path}"
msgstr "项目路径 {path} 有歧义"

#. Refusal: a row was linked after itself
#: src/service.ts
msgid "an intent cannot wait on itself"
msgstr "意图不能等待自身"

#. Refusal: a move named a row in another project's queue
#: src/service.ts
msgid "an intent reorders only within its own project"
msgstr "意图只能在其所属项目的队列内重新排序"

#. A diagnostic's reason, read after the file it names; {cause} is the failure's own text, relayed
#: src/space.ts
msgid "an interrupted sync could not be repaired: {cause}"
msgstr "中断的同步无法修复：{cause}"

#. Refusal: the issue or pull request is already queued; the title is the reader's own text
#: src/service.ts
msgid "an open intent already holds this source: \"{title}\""
msgstr "已有未结意图占用此来源：“{title}”"

#. Guidance under a sync another writer keeps restarting
#: src/space.ts
msgid "Another process is writing to the home; wait for it to finish, then Retry."
msgstr "另一个进程正在写入空间；请等待它完成，然后重试。"

#. Refusal: the session's project has no folder on this device yet
#: src/service.ts
msgid "bind the existing project before changing its session's agents"
msgstr "请先绑定该已有项目，再更改其会话的智能体"

#. Refusal: the session's project has no folder on this device yet
#: src/service.ts
msgid "bind the existing project before retrying"
msgstr "请先绑定该已有项目，然后重试"

#. Config migration failure; `cause` is the migration's own reason and the field names are the config file's
#: src/config-migrate.ts
msgid "cannot migrate the retired profiles config at {path}: {cause} — edit it by hand: each agent takes its own adapter, model, effort, and permissions"
msgstr "无法迁移 {path} 处已废弃的 profiles 配置：{cause} — 请手动编辑：每个智能体各自带有 adapter、model、effort 和 permissions"

#. Spec file error: the filesystem's own reason follows
#: src/specs.ts
msgid "cannot read file: {message}"
msgstr "无法读取文件：{message}"

#. Config error; `captain` is the config file's own field name
#: src/config.ts
msgid "captain must resolve an adapter"
msgstr "captain 必须解析出一个适配器"

#. Guidance where the remote's host could not be reached
#: src/space-git.ts
msgid "Check the network or the remote URL, then try again."
msgstr "请检查网络或远程仓库 URL，然后重试。"

#. Guidance where a local-path remote holds no repository this machine can see; {act} is the act that gives this machine access
#: src/space-git.ts
msgid "Check the path, create the repository if it is not there yet, or {act}. Then Retry."
msgstr "请检查路径，若仓库尚不存在请先创建，或者{act}。然后重试。"

#. Refusal: the remote's side was asked for before the remote was checked
#: src/space.ts
msgid "Check the remote first"
msgstr "请先检查远程仓库"

#. Guidance where the remote holds no repository this machine can see; {act} is the act that gives this machine access
#: src/space-git.ts
msgid "Check the URL, create the repository if it is not there yet, or {act}. Then Retry."
msgstr "请检查 URL，若仓库尚不存在请先创建，或者{act}。然后重试。"

#. Guidance where the selected side of a unit failed validation
#: src/space.ts
msgid "Choose the other side for this unit or fix the file, then Retry."
msgstr "请为该单元改选另一个版本，或修好该文件，然后重试。"

#. Refusal: the compile the Boss awaited was canceled
#. The outcome of a compile the reader stopped
#: src/authoring.ts
#: src/service.ts
msgid "compile canceled"
msgstr "编译已取消"

#. Refusal: the compiler's own stage id, then what it said
#: src/authoring.ts
msgid "compile failed at {phase}: {message}"
msgstr "编译在 {phase} 阶段失败：{message}"

#. Refusal: registration needs a compile that succeeded
#: src/authoring.ts
msgid "compile the draft successfully before registering it"
msgstr "注册前请先成功编译该草稿"

#. Refusal after a successful compile; `error` is the config validation's own words
#: src/service.ts
msgid "compiled, but creating session player \"{playerId}\" was refused: {error}"
msgstr "已编译，但创建会话 Player“{playerId}”被拒绝：{error}"

#. Refusal after a successful compile; `error` is the config validation's own words
#: src/service.ts
msgid "compiled, but registration was refused: {error}"
msgstr "已编译，但注册被拒绝：{error}"

#. Refusal after a successful compile; the role ids are the manifest's own
#: src/service.ts
msgid "compiled, but the playbook's derived roles are [{roles}] and no player was bound for: {unbound}. Re-submit with a binding per derived role; the compiled artifacts are kept."
msgstr "已编译，但规程推导出的角色为 [{roles}]，其中未绑定 Player 的有：{unbound}。请为每个推导出的角色提供绑定后重新提交；编译产物会保留。"

#. The toolchain's guidance; `nodejs.org` is a site and `SPEX_NODE` an environment variable, both as they are
#: src/compile.ts
msgid "Compiling playbooks needs Node >= {major}.{minor} on your system (found {found}). Install it from nodejs.org or set SPEX_NODE."
msgstr "编译规程需要系统中有 Node >= {major}.{minor}（当前为 {found}）。请从 nodejs.org 安装，或设置 SPEX_NODE。"

#. The toolchain's guidance when no Node answered at all; `nodejs.org` is a site and `SPEX_NODE` an environment variable
#: src/compile.ts
msgid "Compiling playbooks needs Node >= {major}.{minor} on your system (found none). Install it from nodejs.org or set SPEX_NODE."
msgstr "编译规程需要系统中有 Node >= {major}.{minor}（未找到任何版本）。请从 nodejs.org 安装，或设置 SPEX_NODE。"

#. Refusal: no config file exists at the path the core reads
#. Refusal: no config file exists at the path the core reads
#. Refusal: no config file exists at the path the core reads
#. Refusal: no config file exists at the path the core reads
#: src/service.ts
msgid "config file is missing"
msgstr "配置文件不存在"

#. Refusal: the config file failed to load; `errors` are the config errors themselves
#: src/service.ts
msgid "config is invalid: {errors}"
msgstr "配置无效：{errors}"

#. Refusal: the loaded config carries errors
#: src/service.ts
msgid "config is not valid"
msgstr "配置无效"

#. Config error: the file's top level is not a mapping
#: src/config.ts
msgid "config must be a YAML mapping"
