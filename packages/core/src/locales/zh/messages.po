#. Config error; the field's dotted path is the config file's own
#: src/config.ts
msgid "Unknown config field {field}"
msgstr "未知的配置字段 {field}"

#. Spec notice: the entry names follow, as the tree spells them
#: src/specs.ts
msgid "unknown entries under specs/: {entries}"
msgstr "specs/ 下存在未知条目：{entries}"

#. Refusal: the diff names a path the unit does not hold
#: src/space.ts
msgid "unknown path {path} in {unit}"
msgstr "{unit} 中没有路径 {path}"

#. Refusal: the act names a unit the current plan does not hold
#: src/space.ts
msgid "unknown unit {unit}"
msgstr "未知单元 {unit}"

#. Storage diagnostic; `cause` is the read failure's own words
#: src/store.ts
msgid "Unreadable cache; refresh to rebuild: {cause}"
msgstr "缓存无法读取；刷新可重建：{cause}"

#. Storage diagnostic: an act's kind or version is not one this Spex reads
#: src/app-storage.ts
msgid "unsupported act/version"
msgstr "不支持的动作类型或版本"

#. Storage diagnostic: the file names a layout version this Spex does not read; the file is left as it is
#: src/i18n.ts
msgid "unsupported format {format}; preserved unchanged"
msgstr "不支持的格式 {format}；已原样保留"

#. Storage diagnostic: a credentials file names a layout version that is no number, which is not repeated; the file is left as it is
#. Storage diagnostic: a credentials file names a layout version that is no number, which is not repeated; the file is left as it is
#: src/code-credentials.ts
#: src/i18n.ts
msgid "unsupported format; preserved unchanged"
msgstr "不支持的格式；已原样保留"

#. Storage diagnostic: the state root's own metadata file cannot be read
#: src/store.ts
msgid "unsupported migration metadata; original bytes preserved"
msgstr "不支持的迁移元数据；已原样保留原始内容"

#. Storage diagnostic: this device's project-to-folder map is not one this Spex reads
#: src/app-storage.ts
msgid "unsupported path-map version or bindings array"
msgstr "不支持的路径映射版本或 bindings 数组"

#. Storage diagnostic: the preferences file is not one this Spex reads
#. Storage diagnostic: the preferences file is not one this Spex reads
#. Storage diagnostic: the preferences file is not one this Spex reads
#: src/app-storage.ts
msgid "unsupported preference version or prefs object"
msgstr "不支持的偏好设置版本或 prefs 对象"

#. Storage diagnostic: the project registry was written by a later Spex
#: src/store.ts
msgid "unsupported registry version"
msgstr "不支持的注册表版本"

#. Storage diagnostic: the project registry's version or shape is not one this Spex reads
#: src/app-storage.ts
msgid "unsupported registry version or projects array"
msgstr "不支持的注册表版本或 projects 数组"

#. An authoring session unit's label where it carries no first message
#: src/space.ts
msgid "untitled authoring session"
msgstr "未命名编写会话"

#. A session unit's label where the session carries no title
#: src/space.ts
msgid "untitled session"
msgstr "未命名会话"

#. Choosing the versions spex.yaml allows and writing spex.lock failed, after Add, Remove or Update; {cause} is the library's or the registry's own words. Retry is the control that runs it again
#: src/environments.ts
msgid "Updating stopped: {cause} — Retry"
msgstr "更新已停止：{cause} — 请重试"

#. Media transfer refusal
#: src/media-transfers.ts
msgid "Upload ID already identifies a different file."
msgstr "此上传 ID 已用于另一个文件。"

#. Startup refusal: a media staging path cannot be safely cleaned
#: src/media.ts
msgid "Upload staging path is unsafe: {path}"
msgstr "上传暂存路径不安全：{path}"

#. Media storage failure
#: src/media-transfers.ts
msgid "Upload write made no progress."
msgstr "无法继续写入上传文件。"

#. Refusal: a turn is running in the project being rebound
#: src/service.ts
msgid "wait for the project's running turn to finish, or abort it, before rebinding"
msgstr "请先等待该项目正在进行的轮次结束或将其中止，再重新绑定"

#. Refusal: a turn is running in the project being removed
#: src/service.ts
msgid "wait for the project's running turn to finish, or abort it, before removing it"
msgstr "请先等待该项目正在进行的轮次结束或将其中止，再移除项目"

#. Refusal: the session being deleted has a turn in flight
#. Refusal: the session being deleted has a turn in flight
#: src/service.ts
#: src/store.ts
msgid "wait for the running turn to finish, or abort it, before deleting"
msgstr "请先等待正在进行的轮次结束或将其中止，再执行删除"

#. Guidance under a sync a held session stopped
#: src/space.ts
msgid "Wait for the session to finish, then Retry."
msgstr "请等待该会话结束，然后重试。"

#. A step the Git host left waiting, with no words of its own
#: src/space-groups.ts
msgid "Waiting"
msgstr "等待中"

#. A spex repository's row while its creation waits; {group} is the group's full path
#: src/space-groups.ts
msgid "Waiting for a member who can create it in {group}"
msgstr "等待在 {group} 中有权创建它的成员"

#. A spex repository's row while its creation waits; {group} is the group's full path, {words} the host's own words
#: src/space-groups.ts
msgid "Waiting for a member who can create it in {group}: {words}"
msgstr "等待在 {group} 中有权创建它的成员：{words}"

#. A spex repository's row while its branch preparation waits; {group} is the group's full path
#: src/space-groups.ts
msgid "Waiting for a member who can prepare its branch in {group}"
msgstr "等待在 {group} 中有权准备其分支的成员"

#. A spex repository's row while its branch preparation waits; {group} is the group's full path, {words} the host's own words
#: src/space-groups.ts
msgid "Waiting for a member who can prepare its branch in {group}: {words}"
msgstr "等待在 {group} 中有权准备其分支的成员：{words}"

#. A step the Git host left waiting; {words} are its own words
#: src/space-groups.ts
msgid "Waiting: {words}"
msgstr "等待中：{words}"

#. Guidance after the reader stopped a transfer to the Git host
#: src/space-git.ts
msgid "You stopped the transfer; your commits stand."
msgstr "你停止了传输；你的提交仍然保留。"

#. Guidance after the reader stopped a transfer
#: src/space-git.ts
msgid "You stopped the transfer; your commits stand. Git runs without prompts, so a helper that prompts fails instead of hanging."
msgstr "你已停止传输；你的提交仍然有效。Git 以无交互方式运行，因此需要交互的凭据助手会直接失败，而不会一直挂起。"

#. Guidance under a push the remote rejected twice
#: src/space.ts
msgid "Your merge is saved locally; Retry to send it once the host settles."
msgstr "合并已保存在本地；待托管平台稳定后重试即可发送。"

#. Refusal: the registry gave no answer listing the orgs this account may publish to; {registry} is its display name
#: src/environments.ts
msgid "Your orgs at {registry} could not be read — check the connection, then Retry"
msgstr "无法读取你在 {registry} 上的 org — 请检查网络连接，然后重试"

#. Readiness on a team server's seat: the agent runs on a credential the member placed in Settings
#: src/seat-credentials.ts
msgid "Your own credential"
msgstr "你自己的凭据"

#. Readiness on a team server's seat: the agent's status command reports the credential the member placed expired or refused
#: src/seat-credentials.ts
msgid "Your own credential has expired"
msgstr "你自己的凭据已过期"

#. Refusal on a team server's seat of a pick or a remote for your own group: its records stay on the server and are placed at no instance
#: src/space.ts
msgid "Your own group stays on this server"
msgstr "你自己的群组只留在这台服务器上"

#. A content-size rejection keeps access unchanged; no membership, sign-in, deletion or history-rewrite advice is implied
#: src/space-git.ts
msgid "Your saved commits remain on this device. Address the content limit, then Retry."
msgstr "已保存的提交仍保留在此设备上。请先解决内容大小限制问题，然后重试。"
