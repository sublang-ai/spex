#. Separates names listed in one message
#. Separates names listed in one message
#. Separates names listed in one message
#. Separates names listed in one message
#: src/config.ts
#: src/i18n.ts
#: src/service.ts
msgid ", "
msgstr "、"

#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#: src/config.ts
#: src/environments.ts
#: src/service.ts
#: src/session.ts
#: src/store.ts
msgid "; "
msgstr "；"

#. Clause of the role-coverage config error: the roles no binding names
#: src/config.ts
msgid "; missing {roles}"
msgstr "；缺少角色 {roles}"

#. Clause naming the fields a record may also carry
#: src/i18n.ts
msgid "; optional {fields}"
msgstr "；可选字段 {fields}"

#. Tail of an adapter's requirement: the steps no install performs, in the runtime's own words
#: src/config.ts
msgid "; then: {steps}"
msgstr "；随后：{steps}"

#. Clause of the role-coverage config error: the bound roles the manifest never declares
#: src/config.ts
msgid "; unknown {roles}"
msgstr "；未知角色 {roles}"

#. Refusal: the id offered for a new playbook breaks the Agent Skills name rule
#: src/service.ts
msgid "\"{id}\" is not a playbook id: lowercase letters, digits and single hyphens, at most 64 characters"
msgstr "“{id}”不是有效的规程 id：只能用小写字母、数字和单个连字符，最多 64 个字符"

#. A session's own title, quoted
#: src/session.ts
msgid "“{title}”"
msgstr "“{title}”"

#. A stopped sync's message: a session is held elsewhere, named by its title
#: src/space.ts
msgid "“{title}” is in use"
msgstr "“{title}”正在使用中"

#. Stands in the branch's place where git names none
#: src/forge.ts
msgid "(unknown)"
msgstr "（未知）"

#. Guidance where an SSH remote refused access; {act} is the act that gives this machine access, already opening the sentence
#: src/space-git.ts
msgid "{act}; on a first connection, accept the host key in a terminal. Then Retry."
msgstr "{act}；首次连接时，请在终端中接受主机密钥。然后重试。"

#. Guidance where the remote refused access; {act} is the act that gives this machine access, already opening the sentence
#: src/space-git.ts
msgid "{act}. Then Retry."
msgstr "{act}。然后重试。"

#. Refusal of an agent's credential on a team server's seat: a variable's name is none of the agent's forms; `adapter` is the agent's name and `forms` lists the variables' names, both as they are
#: src/service.ts
msgid "{adapter} takes only {forms}"
msgstr "{adapter} 只接受 {forms}"

#. Refusal of Install: spex.lock no longer matches what it was written from, so nothing installs until Update; {changes} is the stale report, such as "spex.yaml changed"
#: src/environments.ts
msgid "{changes} — Update first"
msgstr "{changes} — 请先更新"

#. Project creation refusal; command and its output are verbatim
#: src/forge.ts
msgid "{command} failed: {output}"
msgstr "{command} 失败：{output}"

#. Refusal asking a second confirmation: removing the project deletes its spex repository's clone, whose records were never sent
#: src/service.ts
msgid "{count, plural, one {# record has} other {# records have}} not reached the host and would be lost; confirm to remove anyway"
msgstr "{count, plural, other {# 条记录}}尚未送达托管平台，移除将丢失这些记录；仍要移除请再次确认"

#. A stopped Leave: that many records, of the placement being removed or of this device, are held by none of the spex repository's other placements, as this device last fetched or pushed them; a second confirmation removes it anyway
#: src/space.ts
msgid "{count, plural, one {# record has} other {# records have}} reached no other placement"
msgstr "{count, plural, other {# 条记录}}尚未到达其他任何放置"

#. A session unit's detail: how many turns it holds
#: src/space.ts
msgid "{count, plural, one {# turn} other {# turns}}"
msgstr "{count, plural, other {# 个轮次}}"

#. Adapter requirement; `described` is the runtime's own verdict and `npm install` the command to run
#: src/config.ts
msgid "{described} — bundled with Spex; reinstall the app, or run npm install in a checkout"
msgstr "{described} — 随 Spex 内置；请重新安装应用，或在源码目录中运行 npm install"

#. Adapter requirement; `described` is the runtime's own verdict and the npm line is the command to run
#: src/config.ts
msgid "{described} — install with: npm install -g {spec}{steps}"
msgstr "{described} — 安装方式：npm install -g {spec}{steps}"

#. Refusal on a damaged draft: the diagnostic already composed, then the way out
#: src/authoring.ts
msgid "{diagnostic}; delete the draft, or repair the file"
msgstr "{diagnostic}；删除草稿，或修复文件"

#. Config error: a project's or another group's settings file holds a field only your own group's file may hold; {entry} is the field's own path
#: src/config.ts
msgid "{entry} is not allowed in a project's settings, which name only the playbooks they enable and the player each role uses"
msgstr "项目的设置中不允许 {entry}：项目设置只列出所启用的规程及每个角色使用的参与者"

#. Refusal: a file changed between the core's read and its write; the reader retries
#. Refusal: a file changed between the core's read and its write; the reader retries
#: src/home.ts
#: src/i18n.ts
msgid "{file} changed meanwhile; retry"
msgstr "{file} 在此期间已更改；请重试"

#. Refusal: the file moved under the write the reader asked for
#. Refusal: the file moved under the write the reader asked for
#: src/drafts.ts
#: src/specs.ts
msgid "{file} changed on disk since it was read"
msgstr "{file} 在读取之后已在磁盘上更改"

#. A storage fault as one line: the file, then the reason — itself a message
#. A storage fault as one line: the file, then the reason — itself a message
#. A storage fault as one line: the file, then the reason — itself a message
#: src/config.ts
#: src/i18n.ts
#: src/service.ts
msgid "{file}: {reason}"
msgstr "{file}：{reason}"

#. Draft diagnostic: the transcript file, then the last record that still read
#: src/authoring.ts
msgid "{file}: damaged transcript after record {seq}"
msgstr "{file}：记录 {seq} 之后的对话记录已损坏"

#. Refusal of a spex repository's move: the group it was to move into holds one of that name; {group} is that group's path in the instance, {name} the repository's name
#: src/space-groups.ts
msgid "{group} already holds {name}"
msgstr "{group} 中已有 {name}"

#. Refusal of a join or a pick: the group's path is your login's, so its records can have no folder of their own on this device; {group} is the group's path
#: src/space-groups.ts
msgid "{group} is a group named like your login"
msgstr "{group} 是一个与你的用户名同名的群组"

#. Refusal of a group's deletion: it still holds a spex repository or a group; {group} is the group's path in the instance
#: src/space-groups.ts
msgid "{group} is not empty"
msgstr "{group} 不为空"

#. A package Git source failed without a recognized status; raw backing-host or unclassified stderr stays inside the core
#: src/space.ts
msgid "{host} answered with an error"
msgstr "{host} 返回了错误"

#. A stopped transfer: the Git host answered with an HTTP error no other message reads; {host} is its display name, {status} the HTTP status Git printed
#: src/space-git.ts
#: src/space.ts
msgid "{host} answered with an error (HTTP {status})"
msgstr "{host} 返回了错误（HTTP {status}）"

#. The Git host's rate limit; {seconds} is how long it asks to wait, read from its Retry-After
#: src/space-groups.ts
msgid "{host} asks to wait {seconds, plural, one {# second} other {# seconds}}"
msgstr "{host} 要求等待 {seconds, plural, other {# 秒}}"

#. The Git host's rate limit, with no time of its own to wait
#: src/space-groups.ts
msgid "{host} asks to wait a moment"
msgstr "{host} 要求稍候片刻"

#. A stopped sync: the host's repository is empty, so spex waits for its default branch; {host} is its display name
#: src/space.ts
msgid "{host} holds no default branch for it yet"
msgstr "{host} 上它还没有默认分支"

#. A stopped sync: a placement of a spex repository is dropped, which moves its clone to the path of its next placement, at the instance {host} (its display name), which the core has not read since it started
#: src/space.ts
msgid "{host} is not read yet, so the clone cannot move to its path there"
msgstr "尚未读取 {host}，克隆无法移到它在那里的路径"

#. Refusal naming a group the Git host's last read did not list; {group} is the group's id as sent, {host} the host's display name
#: src/space-groups.ts
msgid "{host} listed no group {group}"
msgstr "{host} 未列出群组 {group}"

#. A refusal relayed from the Git host that carried no words; {host} is its display name
#: src/space-git.ts
msgid "{host} refused"
msgstr "{host} 拒绝了"

#. An explicit content-size rejection whose numeric limit is absent or ambiguous; host is the instance display name
#: src/space-git.ts
msgid "{host} refused content above its size limit"
msgstr "{host} 拒绝了超出其大小限制的内容"

#. A content-size rejection, naming only the instance and its reported limit, not the storage system or raw transport words
#: src/space-git.ts
msgid "{host} refused content above its size limit ({limit})"
msgstr "{host} 拒绝了超出其大小限制（{limit}）的内容"

#. A stopped transfer's message; {host} is the remote's host
#: src/space-git.ts
msgid "{host} refused this machine's access"
msgstr "{host} 拒绝了本机的访问"

#. A refusal relayed from the Git host; {host} is its display name, {words} its own words, kept whole
#: src/space-git.ts
msgid "{host} refused: {words}"
msgstr "{host} 拒绝了：{words}"

#. A sign-in on a team server's seat refused, nothing stored: the account approved at the instance is not the member the seat was opened for; {host} is the instance's display name, {login} the login of the account that signed in
#: src/space-groups.ts
msgid "{host} signed you in as @{login}; this seat is another member's"
msgstr "{host} 登录的是 @{login}；这个席位属于另一位成员"

#. A sign-in refused, nothing stored: the person signed in at an instance the home lists as another account than the one it lists there; {host} is the instance's display name, {login} the listed account's login
#: src/space-groups.ts
msgid "{host} signed you in as another account; this device uses @{login} there"
msgstr "{host} 登录的是另一个账户；本设备在那里使用 @{login}"

#. Refusal: the authoring session's file changed, or another session took its id, since the page read it
#: src/authoring.ts
msgid "{id} changed meanwhile; retry"
msgstr "{id} 期间已更改，请重试"

#. Refusal: the id offered for a new playbook is one an installed package exports, in this project or among the packages Spex keeps for you alone
#: src/authoring.ts
msgid "{id} is already a playbook of this project or of your Personal packages — pick another id"
msgstr "{id} 已是本项目或你的个人规约包中的规程 — 请换一个 id"

#. Refusal: the id offered for a new playbook is another project's authoring session
#: src/service.ts
msgid "{id} is already an authoring session of another project; pick another id"
msgstr "{id} 已是另一个项目的编写会话；请换一个 id"

#. Refusal: a choice was sent for a unit the two sides agree on; {label} is the unit's own label
#: src/space.ts
msgid "{label} has no divergent change"
msgstr "{label} 两端没有分歧的更改"

#. Refusal of Publish: the registry holds this version already and never takes it twice; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} {version} is already at {registry} — raise its version in meta.yaml, then Retry"
msgstr "{name} {version} 已在 {registry} 上 — 请在 meta.yaml 中提高其版本，然后重试"

#. Refusal of Publish: the package is larger than the registry takes; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} {version} is too large for {registry} — leave out what it does not need, then Retry"
msgstr "{name} {version} 超出 {registry} 接受的大小 — 请去掉不需要的内容，然后重试"

#. A completed step of an enabling: the package written into spex.yaml
#: src/service.ts
msgid "{name} added to spex.yaml"
msgstr "已将 {name} 添加到 spex.yaml"

#. The stale report: a package added from a folder changed its meta.yaml since spex.lock was written; {path} is that folder. Shown beside the Packages tab's Update control
#: src/environments.ts
msgid "{name} changed in {path}"
msgstr "{name} 在 {path} 中已更改"

#. Repair row: the project is registered, but nothing here holds it
#: src/store.ts
msgid "{name} has no folder on this device"
msgstr "{name} 在本设备上没有文件夹"

#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#: src/drafts.ts
#: src/environments.ts
#: src/service.ts
msgid "{name} has no project folder on this computer — Open here first"
msgstr "{name} 在本机没有项目文件夹 — 请先“在此打开”"

#. Refusal of Place or Attach: the spex repository is a group's own (or, for Place, your own group's), which stays at its one instance; {name} is the repository's name
#: src/space.ts
msgid "{name} holds a group's records; only a project's are placed at another instance"
msgstr "{name} 存放的是群组的记录；只有项目的记录才能放置到另一个实例"

#. Refusal of Leave: the spex repository is a group's own or your own group's, whose placements Leave does not remove; {name} is the repository's name
#: src/space.ts
msgid "{name} holds a group's records; only a project's are removed from an instance"
msgstr "{name} 存放的是群组的记录；只有项目的记录才能从实例移除"

#. Refusal: the command names a placement — an instance, or the remote the reader named — that the spex repository {name} does not hold
#: src/space.ts
msgid "{name} holds no such placement"
msgstr "{name} 没有这个放置"

#. Refusal of a join: a placement file of the spex repository {repository}, on this device, names the spex repository {name} listed at an instance; it stands as a line of {repository}'s row, to attach there, not as a repository of its own
#: src/space.ts
msgid "{name} is a placement of {repository} not on this device yet"
msgstr "{name} 是 {repository} 尚未在本设备上的放置"

#. Refusal: another host holds this project's conversation
#: src/session.ts
msgid "{name} is in use elsewhere in {project}"
msgstr "{project} 中的 {name} 正在别处使用"

#. Refusal of a pick: the spex repository's folder lies under one instance, and the pick named a group at another; {name} is the repository's name, {host} its instance's display name
#: src/space.ts
msgid "{name} is kept under {host}; pick a group there"
msgstr "{name} 位于 {host} 之下；请在那里选择一个群组"

#. Refusal of Publish: a package name is an org and a name joined by a slash, both lowercase words joined by hyphens, as acme/triage is; {name} is what was given
#: src/environments.ts
msgid "{name} is not a package name — name it like acme/triage"
msgstr "{name} 不是规约包名称 — 请写成 acme/triage 这样的形式"

#. A package the registry does not show this signed-in account, either never published or private to others; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} is not at {registry}, or not shared with you — check the name, or ask its owner"
msgstr "{name} 不在 {registry} 上，或未与你共享 — 请检查名称，或询问其所有者"

#. A package the registry does not show, when whether this computer is signed in there cannot be read now; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} is not at {registry}, or private — check the name and your sign-in, then Retry"
msgstr "{name} 不在 {registry} 上，或是私有的 — 请检查名称和登录状态，然后重试"

#. Refusal of Remove: the package is not one spex.yaml adds here, such as one another package requires
#: src/environments.ts
msgid "{name} is not in spex.yaml here"
msgstr "此处的 spex.yaml 中没有 {name}"

#. A private package this account may not read at the registry; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} is not shared with you at {registry} — ask its owner"
msgstr "{name} 在 {registry} 上未与你共享 — 请询问其所有者"

#. Refusal of a pick: the spex repository is not local only
#: src/space.ts
msgid "{name} is on the host already"
msgstr "{name} 已在托管平台上"

#. Refusal of a join: the spex repository has a clone here
#. Refusal of a join: the spex repository has a clone here
#: src/space.ts
msgid "{name} is on this device already"
msgstr "{name} 已在本设备上"

#. Refusal of a pick, Place or Attach that joins the spex repository {name} listed at an instance, already held on this device by the spex repository {repository}, which syncs with it
#: src/space.ts
msgid "{name} is on this device already, as a placement of {repository}"
msgstr "{name} 已作为 {repository} 的放置在本设备上"

#. Refusal of Place or Attach: the spex repository already has a placement at that instance; {name} is the repository's name, {host} the instance's display name
#: src/space.ts
msgid "{name} is placed at {host} already"
msgstr "{name} 已放置在 {host}"

#. A package the registry keeps private, asked while signed out there; {registry} is the registry's display name. 'Sign in to' names the Packages tab's sign-in control
#: src/environments.ts
msgid "{name} is private — Sign in to {registry}"
msgstr "{name} 是私有的 — 请登录 {registry}"

#. A package the registry keeps private, asked while this computer is signed out of the Space whose sign-in a spex.yaml naming no registry reads with; {registry} is the registry's display name. Space is the rail's surface holding the sign-in
#: src/environments.ts
msgid "{name} is private at {registry} — Sign in on Space, then Retry"
msgstr "{name} 在 {registry} 上是私有的 — 请在 Space 中登录，然后重试"

#. A package the registry does not show while this computer is signed out of the Space whose sign-in a spex.yaml naming no registry reads with, either private or never published; {registry} is the registry's display name. Space is the rail's surface holding the sign-in
#: src/environments.ts
msgid "{name} is private or not at {registry} — Sign in on Space, then Retry"
msgstr "{name} 是私有的，或不在 {registry} 上 — 请在 Space 中登录，然后重试"

#. A package the registry does not show while signed out there, either private or never published; {registry} is the registry's display name. 'Sign in to' names the Packages tab's sign-in control
#: src/environments.ts
msgid "{name} is private or not at {registry} — Sign in to {registry}"
msgstr "{name} 是私有的，或不在 {registry} 上 — 请登录 {registry}"

#. Refusal: one working turn per project
#: src/session.ts
msgid "{name} is still working in {project} — wait for it to finish, or abort it"
msgstr "{name} 仍在 {project} 中工作 — 请等待它完成，或中止它"

#. Refusal of a new top-level group's name; {name} is the name typed, {host} the Git host's display name
#: src/space-groups.ts
msgid "{name} is taken at {host}; choose another name"
msgstr "{name} 在 {host} 上已被占用；请另选一个名称"

#. Refusal of a new spex repository's name; {name} is the whole name, {group} the group's full path
#: src/space-groups.ts
msgid "{name} is taken in {group}; choose another name"
msgstr "{name} 在 {group} 中已被占用；请另选一个名称"

#. The registry's operator withdrew the version spex.lock records; {registry} is the registry's display name. Update is the Packages tab's control that picks the versions again
#: src/environments.ts
msgid "{name} is withdrawn at {registry} — Update picks another version"
msgstr "{name} 已在 {registry} 上撤回 — 更新会选择另一个版本"

#. A package added from a folder that holds no meta.yaml; {path} is that folder in the project. Remove is the package row's control
#: src/environments.ts
msgid "{name}: {path} has no meta.yaml, so it is no package — fix the folder, or Remove {name}"
msgstr "{name}：{path} 中没有 meta.yaml，因此不是规约包 — 请修正该文件夹，或移除 {name}"

#. A package added from a folder whose meta.yaml names another package, {found}
#: src/environments.ts
msgid "{name}: {path} holds {found} — fix the name in spex.yaml or in its meta.yaml, then Retry"
msgstr "{name}：{path} 中是 {found} — 请修正 spex.yaml 或其 meta.yaml 中的名称，然后重试"

#. A package added from a folder whose meta.yaml does not pass the checks; {issues} are the checks' own words
#: src/environments.ts
msgid "{name}: {path} is not a package: {issues} — fix its meta.yaml, then Retry"
msgstr "{name}：{path} 不是规约包：{issues} — 请修正其 meta.yaml，然后重试"

#. The registry answered with an HTTP status Spex does not expect when asked for the package {name}; {registry} is its display name, {status} the status, such as 429
#: src/environments.ts
msgid "{name}: {registry} answered {status} — Retry later"
msgstr "{name}：{registry} 返回了 {status} — 请稍后重试"

#. The registry did not answer when asked for the package {name}; {registry} is the registry's display name as last read, else its host
#: src/environments.ts
msgid "{name}: {registry} could not be reached — check the connection, then Retry"
msgstr "{name}：无法连接 {registry} — 请检查网络连接，然后重试"

#. The registry answered that it cannot serve the package {name} now; {registry} is its display name, {status} the HTTP status it answered, such as 503
#: src/environments.ts
msgid "{name}: {registry} is down ({status}) — Retry later"
msgstr "{name}：{registry} 暂时无法服务（{status}）— 请稍后重试"

#. A package added from a folder whose folder is gone; {path} is that folder in the project. Remove is the package row's control
#: src/environments.ts
msgid "{name}: no folder at {path} — put the folder back, or Remove {name}"
msgstr "{name}：{path} 处没有文件夹 — 请放回该文件夹，或移除 {name}"

#. Asked for the package {name}, the Space whose sign-in a spex.yaml naming no registry reads with no longer accepts this computer's sign-in; {registry} is the registry's display name. Space is the rail's surface holding the sign-in
#: src/environments.ts
msgid "{name}: sign-in at {registry} expired — Sign in again on Space"
msgstr "{name}：{registry} 的登录已过期 — 请在 Space 中重新登录"

#. spex.lock records the package's registry by a value that is not an address, so Spex asks it nothing; Update is the Packages tab's control that writes spex.lock again
#: src/environments.ts
msgid "{name}: spex.lock names no registry address for it — Update writes spex.lock again"
msgstr "{name}：spex.lock 没有为它记录注册中心地址 — 更新会重新写入 spex.lock"

#. Refusal of Publish: the registry refuses this account the package's org, a package name's first half; {registry} is the registry's display name
#: src/environments.ts
msgid "{org} is not yours to publish to at {registry} — claim it there, or publish under one of your orgs"
msgstr "你不能在 {registry} 上发布到 {org} — 请在那里认领它，或发布到你自己的 org 下"

#. A stopped sync: the folder a renamed spex repository moves to is taken
#: src/space.ts
msgid "{path} already exists, so the clone cannot follow the host there"
msgstr "{path} 已存在，克隆无法随托管平台移到那里"

#. Refusal of Publish: the package's meta.yaml lacks a field the registry requires, such as description or license; {issues} name each field in the checks' own words
#: src/environments.ts
msgid "{path} cannot be published: {issues} — add them to meta.yaml, then Retry"
msgstr "{path} 无法发布：{issues} — 请将其补入 meta.yaml，然后重试"

#. Refusal of a join: the host's names hold characters a folder under the home cannot
#: src/space.ts
msgid "{path} cannot stand as a folder on this device"
msgstr "{path} 无法作为本设备上的文件夹"

#. Refusal: a Personal package's folder holds a file the records' Git ignores; {file} is that file's path in the records
#: src/environments.ts
msgid "{path} holds {file}, which Git ignores in your Personal records, so it would not sync — remove it, or pick another folder"
msgstr "{path} 含有 {file}，Git 在你的个人记录中会忽略它，因此它不会同步 — 请移除它，或选择其他文件夹"

#. Refusal: a Personal package's folder holds a tracked file of a kind that stays on this computer, such as a *.tmp file forced into Git; {file} is that file's path in the records
#: src/environments.ts
msgid "{path} holds {file}, which your Personal records never share — remove it, or pick another folder"
msgstr "{path} 含有 {file}，你的个人记录从不共享这类文件 — 请移除它，或选择其他文件夹"

#. Refusal of Publish: the folder a publish of {name} reads holds another package, {held}, by its meta.yaml
#: src/environments.ts
msgid "{path} holds {held}, not {name} — fix its meta.yaml, or publish {held}"
msgstr "{path} 中是 {held}，不是 {name} — 请修正其 meta.yaml，或发布 {held}"

#. Refusal: a Personal package's folder is one Spex itself keeps, such as sessions/ or skills/
#: src/environments.ts
msgid "{path} is a folder Spex keeps in your Personal records — pick another folder"
msgstr "{path} 是 Spex 在你的个人记录中自留的文件夹 — 请选择其他文件夹"

#. Refusal: a project already holds this folder
#: src/service.ts
msgid "{path} is already registered"
msgstr "{path} 已注册"

#. Refusal of a join: the folder named is paired already
#: src/space.ts
msgid "{path} is another project's working folder"
msgstr "{path} 是另一个项目的工作文件夹"

#. Refusal: a Personal package's folder is one the records' Git ignores, such as one named *.tmp
#: src/environments.ts
msgid "{path} is ignored by Git in your Personal records, so it would not sync — pick another folder"
msgstr "{path} 在你的个人记录中被 Git 忽略，因此不会同步 — 请选择其他文件夹"

#. Config error: a role is bound to a malformed player id
#: src/config.ts
msgid "{path} is not a canonical player id"
msgstr "{path} 不是规范的 Player id"

#. Config error: a session player's id is malformed
#: src/config.ts
msgid "{path} is not a canonical player id (lowercase segments, dots optional)"
msgstr "{path} 不是规范的 Player id（小写片段，点号可选）"

#. Refusal: a storage validation parent or family is no directory
#. Refusal: the path offered as a project is no directory on this device
#: src/service.ts
#: src/storage-git.ts
msgid "{path} is not a directory"
msgstr "{path} 不是目录"

#. Refusal: a storage validation leaf is no regular file
#. Refusal: the explorer was asked to read something that is no file
#. Refusal: the path offered as a draft's source is no file on this device
#: src/authoring.ts
#: src/space.ts
#: src/storage-git.ts
msgid "{path} is not a file"
msgstr "{path} 不是文件"

#. Refusal: the explorer was asked to list something that is no folder
#: src/space.ts
msgid "{path} is not a folder"
msgstr "{path} 不是文件夹"

#. Refusal: a Personal package's folder is the Personal records' own top folder; 'Personal records' are what Spex keeps for you alone
#: src/environments.ts
msgid "{path} is not a folder inside your Personal records — pick a folder inside them"
msgstr "{path} 不是你的个人记录内的文件夹 — 请选择其中的文件夹"

#. Refusal of Publish: the folder fails the checks a package's meta.yaml and files must pass; {issues} are the checks' own words
#: src/environments.ts
msgid "{path} is not a package Spex can publish: {issues} — fix them, then Retry"
msgstr "{path} 不是 Spex 可以发布的规约包：{issues} — 请修正后重试"

#. Config error; `skills` is the config file's own field name, refused because skills come from the packages a project adds in its spex.yaml
#: src/config.ts
msgid "{path} is not allowed: skills reach agents from the packages spex.yaml adds"
msgstr "不允许使用 {path}：技能来自 spex.yaml 添加的规约包"

#. Refusal: the folder offered for rebinding is no git repository
#: src/service.ts
msgid "{path} is not the root of a git work tree"
msgstr "{path} 不是 git 工作树的根目录"

#. Refusal: a package added or published from a folder names one outside the project folder
#: src/environments.ts
msgid "{path} is outside the project folder — pick a folder inside it"
msgstr "{path} 不在项目文件夹内 — 请选择其中的文件夹"

#. Refusal: a Personal package added or published from a folder names one outside what Spex keeps for you alone
#: src/environments.ts
msgid "{path} is outside your Personal records — pick a folder inside them"
msgstr "{path} 不在你的个人记录内 — 请选择其中的文件夹"

#. Refusal: a Personal package's folder is, or lies under, a link
#: src/environments.ts
msgid "{path} is reached through a link, which your Personal records do not sync — pick the folder itself"
msgstr "{path} 需经由链接访问，而你的个人记录不同步链接 — 请选择文件夹本身"

#. Spec notice; `intents/` is a directory name and stays as it is
#: src/specs.ts
msgid "{path} is shadowed by the same-named file under intents/"
msgstr "{path} 被 intents/ 下的同名文件遮蔽"

#. Config error: a role's binding is neither form
#: src/config.ts
msgid "{path} must be a player id or a binding block"
msgstr "{path} 必须是 Player id 或绑定块"

#. Config error: the value is neither an adapter's name nor a block of agent settings
#: src/config.ts
msgid "{path} must be an adapter shorthand or an agent block"
msgstr "{path} 必须是适配器简写或智能体块"

#. Config error; writable paths stay within the workspace
#: src/permission-paths.ts
msgid "{path} must be workspace-relative"
msgstr "{path} 必须为工作区内的相对路径"

#. Config error; path is the config field location
#: src/permission-paths.ts
msgid "{path} must not be empty"
msgstr "{path} 不得为空"

#. Config error; '..' is the literal parent-directory component
#: src/permission-paths.ts
msgid "{path} must not contain '..' path segments"
msgstr "{path} 不得包含 '..' 路径分段"

#. Config error; path is the config field location
#: src/permission-paths.ts
msgid "{path} must not contain control characters"
msgstr "{path} 不得包含控制字符"

#. Config error; path is the config field location
#: src/permission-paths.ts
msgid "{path} must not contain empty path segments"
msgstr "{path} 不得包含空路径分段"

#. Config error; path is the config field location
#: src/permission-paths.ts
msgid "{path} must not contain glob metacharacters"
msgstr "{path} 不得包含通配符元字符"

#. Config error; path is the config field location
#: src/permission-paths.ts
msgid "{path} must not contain shell expansion or control characters"
msgstr "{path} 不得包含 Shell 展开或控制字符"

#. Config error; path is the config field location
#: src/permission-paths.ts
msgid "{path} must not resolve to the workspace root"
msgstr "{path} 不得指向工作区根目录"

#. Config error; `effort` and `reasoningEffort` are the config file's own field names
#: src/config.ts
msgid "{path} must not set both effort and its legacy alias reasoningEffort"
msgstr "{path} 不能同时设置 effort 和它的旧别名 reasoningEffort"

#. Config error: the agent names no adapter to run on
#. Config error: the agent names no adapter to run on
#: src/config.ts
msgid "{path} must resolve an adapter"
msgstr "{path} 必须解析出一个适配器"

#. Config error: a role binds a player the roster does not define
#: src/config.ts
msgid "{path} names absent session player \"{playerId}\""
msgstr "{path} 指向不存在的会话 Player“{playerId}”"

#. A stopped sync: the folder a renamed spex repository moves to is where another clone, {other}, which the instances migration left at its former place, moves at its own next sync
#: src/space.ts
msgid "{path} waits for {other}, so the clone cannot follow the host there"
msgstr "{path} 留给了等待移入的 {other}，克隆无法随托管平台移到那里"

#. Refusal: a folder inside a Personal package's folder, which Git does not ignore, cannot be read; {entry} is its path in the records
#: src/environments.ts
msgid "{path}: {entry} cannot be read to confirm it syncs with your Personal records — check its permissions, then Retry"
msgstr "{path}：无法读取 {entry}，因而不能确认它会随你的个人记录同步 — 请检查其权限，然后重试"

#. Refusal: a Personal package's folder is, lies in or holds a folder holding .git; {entry} is that folder's path in the records
#: src/environments.ts
msgid "{path}: {entry} is a Git repository of its own, which your Personal records do not sync — move it out, or pick another folder"
msgstr "{path}：{entry} 是一个独立的 Git 仓库，你的个人记录不同步它 — 请将其移出，或选择其他文件夹"

#. Refusal: a Personal package's folder holds a link Git does not ignore; {entry} is the link's path in the records
#: src/environments.ts
msgid "{path}: {entry} is a link, which your Personal records do not sync — replace it with what it links to, or pick another folder"
msgstr "{path}：{entry} 是一个链接，你的个人记录不同步链接 — 请换成它指向的内容，或选择其他文件夹"

#. Refusal: a Personal package's folder holds a special file, such as a pipe or a socket; {entry} is its path in the records
#: src/environments.ts
msgid "{path}: {entry} is no regular file or folder, so your Personal records do not sync it — remove it, or pick another folder"
msgstr "{path}：{entry} 既不是普通文件也不是文件夹，因此你的个人记录不同步它 — 请移除它，或选择其他文件夹"

#. Config error; the key and `adapter`/`permissions`/`instruction`/`workspace` are the config file's own field names
#: src/config.ts
msgid "{path}.{key} is not a role binding key: adapter, permissions, instruction and workspace belong to the session player"
msgstr "{path}.{key} 不是角色绑定的键：adapter、permissions、instruction 和 workspace 属于会话 Player"

#. Config error; `key` is the config file's own field name and `false` its own value
#: src/config.ts
msgid "{path}.{key} must be a string or false (the provider default)"
msgstr "{path}.{key} 必须是字符串或 false（服务商默认值）"

#. Config error; browser is the config field name
#: src/config.ts
msgid "{path}.browser must be a boolean"
msgstr "{path}.browser 必须是布尔值"

#. Config error; the effort, the adapter's name and the valid values are the runtime's own words
#: src/config.ts
msgid "{path}.effort \"{effort}\" is not supported by the \"{adapter}\" adapter (valid: {values})"
msgstr "{path}.effort“{effort}”不受“{adapter}”适配器支持（有效值：{values}）"

#. Config error; `fastMode` is the config file's own field name
#. Config error; `fastMode` is the config file's own field name
#: src/config.ts
msgid "{path}.fastMode must be a boolean"
msgstr "{path}.fastMode 必须是布尔值"

#. Config error; `permissions` is the config file's own field name
#: src/config.ts
msgid "{path}.permissions must be an object"
msgstr "{path}.permissions 必须是对象"

#. Config error; the policy's name and `allow`/`ask`/`deny` are the config file's own words
#: src/config.ts
msgid "{path}.permissions.{policy} must be allow, ask, or deny"
msgstr "{path}.permissions.{policy} 必须是 allow、ask 或 deny"

#. Config error; `permissions.mode`, `auto` and `bypass` are the config file's own words
#: src/config.ts
msgid "{path}.permissions.mode must be auto or bypass"
msgstr "{path}.permissions.mode 必须是 auto 或 bypass"

#. Config error; `permissions.writablePaths` is the config file's own field name
#: src/config.ts
msgid "{path}.permissions.writablePaths must be a string list"
msgstr "{path}.permissions.writablePaths 必须是字符串列表"

#. Config error; `player` is the config file's own field name
#: src/config.ts
msgid "{path}.player must name a canonical player id"
msgstr "{path}.player 必须指向规范的 Player id"

#. Config error; `profile`, `adapter`, `model`, `effort` and `permissions` are the config file's own field names
#: src/config.ts
msgid "{path}.profile is retired: agents carry their own adapter, model, effort, and permissions"
msgstr "{path}.profile 已废弃：每个智能体自带 adapter、model、effort 和 permissions"

#. Config migration failure; `profile` and `profiles` are the file's own retired field names
#: src/config-migrate.ts
msgid "{path}.profile names \"{name}\", which no profiles entry defines"
msgstr "{path}.profile 指向“{name}”，但 profiles 中没有该条目"

#. Config error; `subagentEffort` is the config file's own field name, and the adapter's name and the values the runtime's own
#: src/config.ts
msgid "{path}.subagentEffort for adapter \"{adapter}\" must be one of: {values}"
msgstr "“{adapter}”适配器的 {path}.subagentEffort 必须是以下之一：{values}"

#. Config error; `subagentEffort` and `subagentModel` are the config file's own field names and the adapter's name the runtime's own
#: src/config.ts
msgid "{path}.subagentEffort for adapter \"{adapter}\" requires subagentModel"
msgstr "“{adapter}”适配器的 {path}.subagentEffort 需要同时设置 subagentModel"

#. Config error; `subagentEffort` is the config file's own field name and the adapter's name the runtime's own
#: src/config.ts
msgid "{path}.subagentEffort is not supported for adapter \"{adapter}\""
msgstr "{path}.subagentEffort 不受“{adapter}”适配器支持"

#. Config error; `subagentModel` is the config file's own field name and the adapter's name the runtime's own
#: src/config.ts
msgid "{path}.subagentModel is not supported for adapter \"{adapter}\""
msgstr "{path}.subagentModel 不受“{adapter}”适配器支持"

#. Config error; `subagentModel` is the config file's own field name
#: src/config.ts
msgid "{path}.subagentModel must be a nonblank string"
msgstr "{path}.subagentModel 必须是非空字符串"

#. The registry answered with an HTTP status Spex does not expect; {registry} is its display name, {status} the status, such as 429
#: src/environments.ts
msgid "{registry} answered {status} — Retry later"
msgstr "{registry} 返回了 {status} — 请稍后重试"

#. The registry did not answer; {registry} is the registry's display name as last read, else its host
#. The registry did not answer; {registry} is the registry's display name as last read, else its host
#: src/environments.ts
#: src/registry.ts
msgid "{registry} could not be reached — check the connection, then Retry"
msgstr "无法连接 {registry} — 请检查网络连接，然后重试"

#. The registry answered that it cannot serve now; {registry} is its display name, {status} the HTTP status it answered, such as 503
#: src/environments.ts
msgid "{registry} is down ({status}) — Retry later"
msgstr "{registry} 暂时无法服务（{status}）— 请稍后重试"

#. Refusal of a share at a role the Git host does not list; {role} is the role named, {host} the host's display name
#: src/space-groups.ts
