#: src/config.ts
msgid "{described} — install with: npm install -g {spec}{steps}"
msgstr "{described} — install with: npm install -g {spec}{steps}"

#. Refusal on a damaged draft: the diagnostic already composed, then the way out
#: src/authoring.ts
msgid "{diagnostic}; delete the draft, or repair the file"
msgstr "{diagnostic}; delete the draft, or repair the file"

#. Config error: a project's or another group's settings file holds a field only your own group's file may hold; {entry} is the field's own path
#: src/config.ts
msgid "{entry} is not allowed in a project's settings, which name only the playbooks they enable and the player each role uses"
msgstr "{entry} is not allowed in a project's settings, which name only the playbooks they enable and the player each role uses"

#. Refusal: the file moved under the write the reader asked for
#. Refusal: the file moved under the write the reader asked for
#: src/drafts.ts
#: src/specs.ts
