msgstr "{name} changed in {path}; resolve again to install"

#. Repair row: the project is registered, but nothing here holds it
#: src/store.ts
msgid "{name} has no folder on this device"
msgstr "{name} has no folder on this device"

#. Refusal: another host holds this project's conversation
#: src/session.ts
msgid "{name} is in use elsewhere in {project}"
msgstr "{name} is in use elsewhere in {project}"

#. Refusal: removing a spec package this environment does not request
#: src/environments.ts
msgid "{name} is not requested here"
msgstr "{name} is not requested here"

#. Refusal of a pick: the spex repository is not local only
#: src/space.ts
msgid "{name} is on the host already"
msgstr "{name} is on the host already"

#. Refusal of a join: the spex repository has a clone here
#. Refusal of a join: the spex repository has a clone here
#: src/space.ts
msgid "{name} is on this device already"
msgstr "{name} is on this device already"

#. Refusal: a request by path needs the repository's working folder here
#: src/environments.ts
