#. Separates names listed in one message
#. Separates names listed in one message
#. Separates names listed in one message
#. Separates names listed in one message
#: src/config.ts
#: src/i18n.ts
#: src/service.ts
msgid ", "
msgstr ", "

#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#. Separates reasons listed in one message
#: src/config.ts
#: src/environments.ts
#: src/service.ts
#: src/session.ts
#: src/store.ts
msgid "; "
msgstr "; "

#. Clause of the role-coverage config error: the roles no binding names
#: src/config.ts
msgid "; missing {roles}"
msgstr "; missing {roles}"

#. Clause naming the fields a record may also carry
#: src/i18n.ts
msgid "; optional {fields}"
msgstr "; optional {fields}"

#. Tail of an adapter's requirement: the steps no install performs, in the runtime's own words
#: src/config.ts
msgid "; then: {steps}"
msgstr "; then: {steps}"

#. Clause of the role-coverage config error: the bound roles the manifest never declares
#: src/config.ts
msgid "; unknown {roles}"
msgstr "; unknown {roles}"

#. Refusal: the id offered for a new playbook breaks the Agent Skills name rule
#: src/service.ts
msgid "\"{id}\" is not a playbook id: lowercase letters, digits and single hyphens, at most 64 characters"
msgstr "\"{id}\" is not a playbook id: lowercase letters, digits and single hyphens, at most 64 characters"

#. A session's own title, quoted
#: src/session.ts
msgid "“{title}”"
msgstr "“{title}”"

#. A stopped sync's message: a session is held elsewhere, named by its title
#: src/space.ts
msgid "“{title}” is in use"
msgstr "“{title}” is in use"

#. Stands in the branch's place where git names none
#: src/forge.ts
msgid "(unknown)"
msgstr "(unknown)"

#. Refusal of an agent's credential on a team server's seat: a variable's name is none of the agent's forms; `adapter` is the agent's name and `forms` lists the variables' names, both as they are
#: src/service.ts
msgid "{adapter} takes only {forms}"
msgstr "{adapter} takes only {forms}"

#. Refusal of Install: spex.lock no longer matches what it was written from, so nothing installs until Update; {changes} is the stale report, such as "spex.yaml changed"
#: src/environments.ts
msgid "{changes} — Update first"
msgstr "{changes} — Update first"

#. Project creation refusal; command and its output are verbatim
#: src/forge.ts
msgid "{command} failed: {output}"
msgstr "{command} failed: {output}"

#. A stopped removal of a project's records from one Space: that many records, of that Space or of this computer, reached none of the other Spaces the project syncs with, as this computer last saw them; a second confirmation removes them anyway
#: src/space.ts
msgid "{count, plural, one {# record has} other {# records have}} reached no other Space"
msgstr "{count, plural, one {# record has} other {# records have}} reached no other Space"

#. Refusal asking a second confirmation of removing a project, which the Overview reads before its own "Remove anyway?": removing it deletes its records from this computer, and that many were never sent to any Space
#: src/service.ts
msgid "{count, plural, one {# record never reached a Space.} other {# records never reached a Space.}}"
msgstr "{count, plural, one {# record never reached a Space.} other {# records never reached a Space.}}"

#. A session unit's detail: how many turns it holds
#: src/space.ts
msgid "{count, plural, one {# turn} other {# turns}}"
msgstr "{count, plural, one {# turn} other {# turns}}"

#. Adapter requirement; `described` is the runtime's own verdict and `npm install` the command to run
#: src/config.ts
msgid "{described} — bundled with Spex; reinstall the app, or run npm install in a checkout"
msgstr "{described} — bundled with Spex; reinstall the app, or run npm install in a checkout"

#. Adapter requirement; `described` is the runtime's own verdict and the npm line is the command to run
#: src/config.ts
msgid "{described} — install with: npm install -g {spec}{steps}"
msgstr "{described} — install with: npm install -g {spec}{steps}"

#. Refusal on a damaged draft: the diagnostic already composed, then the way out
#: src/authoring.ts
msgid "{diagnostic}; delete the draft, or repair the file"
msgstr "{diagnostic}; delete the draft, or repair the file"

#. Config error: a project's or another group's settings file holds a field only your own group's file may hold; {entry} is the field's own path
#: src/config.ts
msgid "{entry} is not allowed in a project's settings, which name only the playbooks they enable and the player each role uses"
msgstr "{entry} is not allowed in a project's settings, which name only the playbooks they enable and the player each role uses"

#. Refusal: a file changed between the core's read and its write; the reader retries
#. Refusal: a file changed between the core's read and its write; the reader retries
#: src/home.ts
#: src/i18n.ts
msgid "{file} changed meanwhile; retry"
msgstr "{file} changed meanwhile; retry"

#. Refusal: the file moved under the write the reader asked for
#. Refusal: the file moved under the write the reader asked for
#: src/drafts.ts
#: src/specs.ts
msgid "{file} changed on disk since it was read"
msgstr "{file} changed on disk since it was read"

#. A storage fault as one line: the file, then the reason — itself a message
#. A storage fault as one line: the file, then the reason — itself a message
#. A storage fault as one line: the file, then the reason — itself a message
#: src/config.ts
#: src/i18n.ts
#: src/service.ts
msgid "{file}: {reason}"
msgstr "{file}: {reason}"

#. Draft diagnostic: the transcript file, then the last record that still read
#: src/authoring.ts
msgid "{file}: damaged transcript after record {seq}"
msgstr "{file}: damaged transcript after record {seq}"

#. Refusal of moving a project's records into a group that holds records of that name; {group} is that group's path at the Space, {name} the name
#: src/space-groups.ts
msgid "{group} already holds {name}"
msgstr "{group} already holds {name}"

#. Refusal of Open here or Add to a group…: the group's path is your login's, so its records can have no folder of their own on this computer; {group} is the group's path
#: src/space-groups.ts
msgid "{group} is a group named like your login"
msgstr "{group} is a group named like your login"

#. Refusal of a group's deletion: it still holds a project's records or a group; {group} is the group's path at the Space
#: src/space-groups.ts
msgid "{group} is not empty"
msgstr "{group} is not empty"

#. A package Git source failed without a recognized status; raw backing-host or unclassified stderr stays inside the core
#: src/space.ts
msgid "{host} answered with an error"
msgstr "{host} answered with an error"

#. A stopped transfer: the Space answered with an HTTP error no other message reads; {host} is its display name, {status} the HTTP status Git printed
#: src/space-git.ts
#: src/space.ts
msgid "{host} answered with an error (HTTP {status})"
msgstr "{host} answered with an error (HTTP {status})"

#. The Space's rate limit; {host} is its display name, {seconds} how long it asks to wait, read from its Retry-After
#: src/space-groups.ts
msgid "{host} asks to wait {seconds, plural, one {# second} other {# seconds}}"
msgstr "{host} asks to wait {seconds, plural, one {# second} other {# seconds}}"

#. The Space's rate limit, with no time of its own to wait; {host} is its display name
#: src/space-groups.ts
msgid "{host} asks to wait a moment"
msgstr "{host} asks to wait a moment"

#. A stopped sync's message: the Space's records moved again while this computer was sending; {host} is the Space's display name, or the remote the reader named as a report reads it
#. A stopped sync's message: the records moved again at the remote while this computer was sending; {host} is the remote's host name, or a local remote as written
#: src/space-git.ts
#: src/space.ts
msgid "{host} changed again"
msgstr "{host} changed again"

#. A stopped sync: the project's records at the Space are empty, so their spex branch waits for the default branch; {host} is the Space's display name
#: src/space.ts
msgid "{host} holds no default branch for it yet"
msgstr "{host} holds no default branch for it yet"

#. A stopped sync: the project's records stop syncing with one Space and move to where the next Space it syncs with keeps them, at {host} (its display name), which Spex has not read since it started
#: src/space.ts
msgid "{host} is not read yet, so these records cannot move there"
msgstr "{host} is not read yet, so these records cannot move there"

#. Refusal naming a group the Space's last read did not list; {group} is the group's id as sent, {host} the Space's display name
#: src/space-groups.ts
msgid "{host} listed no group {group}"
msgstr "{host} listed no group {group}"

#. Refusal of a pick naming a group the Space does not list; {host} is its display name; Refresh is the Space surface's control
#: src/space.ts
msgid "{host} lists no such group — Refresh, then pick again"
msgstr "{host} lists no such group — Refresh, then pick again"

#. A refusal relayed from the Space that carried no words; {host} is its display name
#: src/space-git.ts
msgid "{host} refused"
msgstr "{host} refused"

#. An explicit content-size rejection whose numeric limit is absent or ambiguous; host is the Space's display name
#: src/space-git.ts
msgid "{host} refused content above its size limit"
msgstr "{host} refused content above its size limit"

#. A content-size rejection, naming only the Space and its reported limit, not the storage system or raw transport words
#: src/space-git.ts
msgid "{host} refused content above its size limit ({limit})"
msgstr "{host} refused content above its size limit ({limit})"

#. A stopped transfer's message; {host} is the remote's host name
#: src/space-git.ts
msgid "{host} refused this computer's access"
msgstr "{host} refused this computer's access"

#. A refusal relayed from the Space; {host} is its display name, {words} its own words, kept whole
#: src/space-git.ts
msgid "{host} refused: {words}"
msgstr "{host} refused: {words}"

#. A sign-in on a team server refused, nothing stored: the account approved at the Space is not the member the server was opened for, whose login the server does not know; {host} is the Space's display name, {login} the login of the account that signed in
#: src/space-groups.ts
msgid "{host} signed you in as @{login} — sign in with your own account"
msgstr "{host} signed you in as @{login} — sign in with your own account"

#. A sign-in refused, nothing stored: the person signed in at a Space this computer already signs in to as another account; {host} is the Space's display name, {login} the login this computer signs in with there
#: src/space-groups.ts
msgid "{host} signed you in as another account — sign in as @{login}"
msgstr "{host} signed you in as another account — sign in as @{login}"

#. Refusal: the authoring session's file changed, or another session took its id, since the page read it
#: src/authoring.ts
msgid "{id} changed meanwhile; retry"
msgstr "{id} changed meanwhile; retry"

#. Refusal: the id offered for a new playbook is one an installed package exports, in this project or among the packages Spex keeps for you alone
#: src/authoring.ts
msgid "{id} is already a playbook of this project or of your Personal packages — pick another id"
msgstr "{id} is already a playbook of this project or of your Personal packages — pick another id"

#. Refusal: the id offered for a new playbook is another project's authoring session
#: src/service.ts
msgid "{id} is already an authoring session of another project; pick another id"
msgstr "{id} is already an authoring session of another project; pick another id"

#. Refusal: a choice was sent for a change both sides agree on; {label} is the change's own label; Check is the Sync tab's control
#: src/space.ts
msgid "{label} needs no choice — Check, then choose again"
msgstr "{label} needs no choice — Check, then choose again"

#. Refusal of Publish: the registry holds this version already and never takes it twice; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} {version} is already at {registry} — raise its version in meta.yaml, then Retry"
msgstr "{name} {version} is already at {registry} — raise its version in meta.yaml, then Retry"

#. Refusal of Publish: the package is larger than the registry takes; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} {version} is too large for {registry} — leave out what it does not need, then Retry"
msgstr "{name} {version} is too large for {registry} — leave out what it does not need, then Retry"

#. A completed step of an enabling: the package written into spex.yaml
#: src/service.ts
msgid "{name} added to spex.yaml"
msgstr "{name} added to spex.yaml"

#. Refusal of Add to a group…: the project's records belong to one Space, and the pick named a group at another; {name} is the project, {host} its Space's display name
#: src/space.ts
msgid "{name} belongs to {host} — pick a group there"
msgstr "{name} belongs to {host} — pick a group there"

#. Refusal of Open here: a file of the project {project}, on this computer, names the records {name} a Space lists as records of {project}, so they open with it and not on their own
#: src/space.ts
msgid "{name} belongs to {project} on this computer — open {project} instead"
msgstr "{name} belongs to {project} on this computer — open {project} instead"

#. The stale report: a package added from a folder changed its meta.yaml since spex.lock was written; {path} is that folder. Shown beside the Packages tab's Update control
#: src/environments.ts
msgid "{name} changed in {path}"
msgstr "{name} changed in {path}"

#. Refusal: the command names a Space, or a remote the reader named, that the project's records {name} do not sync with
#: src/space.ts
msgid "{name} does not sync there"
msgstr "{name} does not sync there"

#. Repair row: the project's records are here, but no project folder on this computer holds it
#: src/store.ts
msgid "{name} has no folder on this computer"
msgstr "{name} has no folder on this computer"

#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#. Refusal: package work in a project not opened on this computer, so its spex.yaml has no folder here; 'Open here' is the project's control on the Space surface
#: src/drafts.ts
#: src/environments.ts
#: src/service.ts
msgid "{name} has no project folder on this computer — Open here first"
msgstr "{name} has no project folder on this computer — Open here first"

#. Refusal of attaching a project's records at a Space: no file of the project names records that Space lists for this account; {name} is the project, {host} the Space's display name
#: src/space.ts
msgid "{name} has no records at {host} to attach — Refresh, then Retry"
msgstr "{name} has no records at {host} to attach — Refresh, then Retry"

#. Refusal of sharing a project's records at a Space they already sync with; {name} is the project, {host} the Space's display name
#: src/space.ts
msgid "{name} is at {host} already"
msgstr "{name} is at {host} already"

#. Refusal of Add to a group…: the project's records already sync with a Space; {name} is the project
#: src/space.ts
msgid "{name} is in a group already"
msgstr "{name} is in a group already"

#. Refusal: another host holds this project's conversation
#: src/session.ts
msgid "{name} is in use elsewhere in {project}"
msgstr "{name} is in use elsewhere in {project}"

#. Refusal of Publish: a package name is an org and a name joined by a slash, both lowercase words joined by hyphens, as acme/triage is; {name} is what was given
#: src/environments.ts
msgid "{name} is not a package name — name it like acme/triage"
msgstr "{name} is not a package name — name it like acme/triage"

#. Refusal: the act names a change the current comparison does not hold; {name} is the change's file or folder; Check is the Sync tab's control
#: src/space.ts
msgid "{name} is not among the changes — Check, then choose again"
msgstr "{name} is not among the changes — Check, then choose again"

#. A package the registry does not show this signed-in account, either never published or private to others; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} is not at {registry}, or not shared with you — check the name, or ask its owner"
msgstr "{name} is not at {registry}, or not shared with you — check the name, or ask its owner"

#. A package the registry does not show, when whether this computer is signed in there cannot be read now; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} is not at {registry}, or private — check the name and your sign-in, then Retry"
msgstr "{name} is not at {registry}, or private — check the name and your sign-in, then Retry"

#. Refusal of Remove: the package is not one spex.yaml adds here, such as one another package requires
#: src/environments.ts
msgid "{name} is not in spex.yaml here"
msgstr "{name} is not in spex.yaml here"

#. Refusal: the command names a project's or a group's records that this computer does not hold; {name} names them; Refresh is the Space surface's control
#: src/space.ts
msgid "{name} is not on this computer — Refresh, then Retry"
msgstr "{name} is not on this computer — Refresh, then Retry"

#. A private package this account may not read at the registry; {registry} is the registry's display name
#: src/environments.ts
msgid "{name} is not shared with you at {registry} — ask its owner"
msgstr "{name} is not shared with you at {registry} — ask its owner"

#. Refusal of Open here: the project's records are on this computer already; {name} is the project; Show is the row's control once a project is open here
#: src/space.ts
msgid "{name} is on this computer already — Show it instead"
msgstr "{name} is on this computer already — Show it instead"

#. Refusal of joining records a Space lists, {name}, that this computer already holds: the project {project} syncs with them
#: src/space.ts
msgid "{name} is on this computer already, syncing with {project}"
msgstr "{name} is on this computer already, syncing with {project}"

#. A package the registry keeps private, asked while signed out there; {registry} is the registry's display name. 'Sign in to' names the Packages tab's sign-in control
#: src/environments.ts
msgid "{name} is private — Sign in to {registry}"
msgstr "{name} is private — Sign in to {registry}"

#. A package the registry keeps private, asked while this computer is signed out of the Space whose sign-in a spex.yaml naming no registry reads with; {registry} is the registry's display name. Space is the rail's surface holding the sign-in
#: src/environments.ts
msgid "{name} is private at {registry} — Sign in on Space, then Retry"
msgstr "{name} is private at {registry} — Sign in on Space, then Retry"

#. A package the registry does not show while this computer is signed out of the Space whose sign-in a spex.yaml naming no registry reads with, either private or never published; {registry} is the registry's display name. Space is the rail's surface holding the sign-in
#: src/environments.ts
msgid "{name} is private or not at {registry} — Sign in on Space, then Retry"
msgstr "{name} is private or not at {registry} — Sign in on Space, then Retry"

#. A package the registry does not show while signed out there, either private or never published; {registry} is the registry's display name. 'Sign in to' names the Packages tab's sign-in control
#: src/environments.ts
msgid "{name} is private or not at {registry} — Sign in to {registry}"
msgstr "{name} is private or not at {registry} — Sign in to {registry}"

#. Refusal: one working turn per project
#: src/session.ts
msgid "{name} is still working in {project} — wait for it to finish, or abort it"
msgstr "{name} is still working in {project} — wait for it to finish, or abort it"

#. Refusal of a new top-level group's name; {name} is the name typed, {host} the Space's display name
#: src/space-groups.ts
msgid "{name} is taken at {host}; choose another name"
msgstr "{name} is taken at {host}; choose another name"

#. Refusal of a name in a group: the Space reports it taken there; {name} is the name, {group} the group's full path
#: src/space-groups.ts
msgid "{name} is taken in {group}; choose another name"
msgstr "{name} is taken in {group}; choose another name"

#. The registry's operator withdrew the version spex.lock records; {registry} is the registry's display name. Update is the Packages tab's control that picks the versions again
#: src/environments.ts
msgid "{name} is withdrawn at {registry} — Update picks another version"
msgstr "{name} is withdrawn at {registry} — Update picks another version"

#. Refusal of sharing records at another Space, or of removing them from one: they are a group's own or your Personal records, which stay at their one Space; {name} names them
#. Refusal of sharing records at another Space, or of removing them from one: they are a group's own or your Personal records, which stay at their one Space; {name} names them
#: src/space.ts
msgid "{name} stays at its one Space"
msgstr "{name} stays at its one Space"

#. A package added from a folder that holds no meta.yaml; {path} is that folder in the project. Remove is the package row's control
#: src/environments.ts
msgid "{name}: {path} has no meta.yaml, so it is no package — fix the folder, or Remove {name}"
msgstr "{name}: {path} has no meta.yaml, so it is no package — fix the folder, or Remove {name}"

#. A package added from a folder whose meta.yaml names another package, {found}
#: src/environments.ts
msgid "{name}: {path} holds {found} — fix the name in spex.yaml or in its meta.yaml, then Retry"
msgstr "{name}: {path} holds {found} — fix the name in spex.yaml or in its meta.yaml, then Retry"

#. A package added from a folder whose meta.yaml does not pass the checks; {issues} are the checks' own words
#: src/environments.ts
msgid "{name}: {path} is not a package: {issues} — fix its meta.yaml, then Retry"
msgstr "{name}: {path} is not a package: {issues} — fix its meta.yaml, then Retry"

#. The registry answered with an HTTP status Spex does not expect when asked for the package {name}; {registry} is its display name, {status} the status, such as 429
#: src/environments.ts
msgid "{name}: {registry} answered {status} — Retry later"
msgstr "{name}: {registry} answered {status} — Retry later"

#. The registry did not answer when asked for the package {name}; {registry} is the registry's display name as last read, else its host
#: src/environments.ts
msgid "{name}: {registry} could not be reached — check the connection, then Retry"
msgstr "{name}: {registry} could not be reached — check the connection, then Retry"

#. The registry answered that it cannot serve the package {name} now; {registry} is its display name, {status} the HTTP status it answered, such as 503
#: src/environments.ts
msgid "{name}: {registry} is down ({status}) — Retry later"
msgstr "{name}: {registry} is down ({status}) — Retry later"

#. A package added from a folder whose folder is gone; {path} is that folder in the project. Remove is the package row's control
#: src/environments.ts
msgid "{name}: no folder at {path} — put the folder back, or Remove {name}"
msgstr "{name}: no folder at {path} — put the folder back, or Remove {name}"

#. Asked for the package {name}, the Space whose sign-in a spex.yaml naming no registry reads with no longer accepts this computer's sign-in; {registry} is the registry's display name. Space is the rail's surface holding the sign-in
#: src/environments.ts
msgid "{name}: sign-in at {registry} expired — Sign in again on Space"
msgstr "{name}: sign-in at {registry} expired — Sign in again on Space"

#. spex.lock records the package's registry by a value that is not an address, so Spex asks it nothing; Update is the Packages tab's control that writes spex.lock again
#: src/environments.ts
msgid "{name}: spex.lock names no registry address for it — Update writes spex.lock again"
msgstr "{name}: spex.lock names no registry address for it — Update writes spex.lock again"

#. Refusal of Publish: the registry refuses this account the package's org, a package name's first half; {registry} is the registry's display name
#: src/environments.ts
msgid "{org} is not yours to publish to at {registry} — claim it there, or publish under one of your orgs"
msgstr "{org} is not yours to publish to at {registry} — claim it there, or publish under one of your orgs"

#. A stopped sync: the Space renamed or moved the project's records, and the folder on this computer they would move to is taken; {path} is that folder
#: src/space.ts
msgid "{path} already exists, so these records cannot move there"
msgstr "{path} already exists, so these records cannot move there"

#. Refusal of Open here: the names the Space gives the records hold characters a folder on this computer cannot; {path} is their path at the Space
#: src/space.ts
msgid "{path} cannot be a folder on this computer — rename it at its Space"
msgstr "{path} cannot be a folder on this computer — rename it at its Space"

#. Refusal of Publish: the package's meta.yaml lacks a field the registry requires, such as description or license; {issues} name each field in the checks' own words
#: src/environments.ts
msgid "{path} cannot be published: {issues} — add them to meta.yaml, then Retry"
msgstr "{path} cannot be published: {issues} — add them to meta.yaml, then Retry"

#. Refusal: a Personal package's folder holds a file the records' Git ignores; {file} is that file's path in the records
#: src/environments.ts
msgid "{path} holds {file}, which Git ignores in your Personal records, so it would not sync — remove it, or pick another folder"
msgstr "{path} holds {file}, which Git ignores in your Personal records, so it would not sync — remove it, or pick another folder"

#. Refusal: a Personal package's folder holds a tracked file of a kind that stays on this computer, such as a *.tmp file forced into Git; {file} is that file's path in the records
#: src/environments.ts
msgid "{path} holds {file}, which your Personal records never share — remove it, or pick another folder"
msgstr "{path} holds {file}, which your Personal records never share — remove it, or pick another folder"

#. Refusal of Publish: the folder a publish of {name} reads holds another package, {held}, by its meta.yaml
#: src/environments.ts
msgid "{path} holds {held}, not {name} — fix its meta.yaml, or publish {held}"
msgstr "{path} holds {held}, not {name} — fix its meta.yaml, or publish {held}"

#. Refusal: a package added by its folder names no package and the folder's meta.yaml names none either; {path} is the folder; keep meta.yaml as it is
#: src/environments.ts
msgid "{path} holds no meta.yaml naming a package"
msgstr "{path} holds no meta.yaml naming a package"

#. Refusal: a Personal package's folder is one Spex itself keeps, such as sessions/ or skills/
#: src/environments.ts
msgid "{path} is a folder Spex keeps in your Personal records — pick another folder"
msgstr "{path} is a folder Spex keeps in your Personal records — pick another folder"

#. Refusal: a project already holds this folder
#: src/service.ts
msgid "{path} is already registered"
msgstr "{path} is already registered"

#. Refusal of Open here: the folder chosen is another project's already; {path} is the folder
#: src/space.ts
msgid "{path} is another project's folder — choose another"
msgstr "{path} is another project's folder — choose another"

#. Refusal: a Personal package's folder is one the records' Git ignores, such as one named *.tmp
#: src/environments.ts
msgid "{path} is ignored by Git in your Personal records, so it would not sync — pick another folder"
