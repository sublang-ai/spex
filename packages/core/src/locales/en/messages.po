msgstr "{host} asks to wait; try again after {retry}"

#. The Git host's rate limit, with no retry time of its own
#: src/space-groups.ts
msgid "{host} asks to wait; try again later"
msgstr "{host} asks to wait; try again later"

#. A stopped sync: the host's repository is empty, so spex waits for its default branch; {host} is its display name
#: src/space.ts
msgid "{host} holds no default branch for it yet"
msgstr "{host} holds no default branch for it yet"

#. A refusal relayed from the Git host that carried no words; {host} is its display name
#: src/space-git.ts
msgid "{host} refused"
msgstr "{host} refused"

#. A stopped transfer's message; {host} is the remote's host
#: src/space-git.ts
msgid "{host} refused this machine's access"
msgstr "{host} refused this machine's access"

#. A refusal relayed from the Git host; {host} is its display name, {words} its own words, kept whole
#: src/space-git.ts
msgid "{host} refused: {words}"
msgstr "{host} refused: {words}"

#. Refusal: the authoring session's file changed, or another session took its id, since the page read it
#: src/authoring.ts
msgid "{id} changed meanwhile; retry"
msgstr "{id} changed meanwhile; retry"

#. Refusal: the id offered for a new playbook is one an installed spec package exports
#: src/authoring.ts
