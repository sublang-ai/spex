#. A storage fault as one line: the file, then the reason — itself a message
#: src/files.ts
#: src/service.ts
msgid "{file}: {reason}"
msgstr "{file}: {reason}"

#. Draft diagnostic: the transcript file, then the last record that still read
#: src/authoring.ts
msgid "{file}: damaged transcript after record {seq}"
msgstr "{file}: damaged transcript after record {seq}"

#. The Git host's rate limit; {retry} is its own Retry-After value, kept as given
#: src/space-groups.ts
