{
  "name": "@sublang/spex",
  "version": "5.0.0",
  "description": "The essential spec layer AI agents need to build software reliably",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublang-ai/spex.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "spex",
    "ai-agents",
    "specs",
    "specification",
    "spec-driven-development",
    "scaffold",
    "cli"
  ],
  "bin": {
    "spex": "dist/cli.js"
  },
  "exports": {
    "./environment": {
      "types": "./dist/lib/environment/index.d.ts",
      "default": "./dist/lib/environment/index.js"
    },
    "./files": {
      "types": "./dist/lib/files.d.ts",
      "default": "./dist/lib/files.js"
    },
    "./instance": {
      "types": "./dist/lib/instance.d.ts",
      "default": "./dist/lib/instance.js"
    },
    "./git-host": {
      "types": "./dist/lib/git-host.d.ts",
      "default": "./dist/lib/git-host.js"
    },
    "./home-file": {
      "types": "./dist/lib/home-file.d.ts",
      "default": "./dist/lib/home-file.js"
    },
    "./words": {
      "types": "./dist/lib/words.d.ts",
      "default": "./dist/lib/words.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./scaffold/*": "./scaffold/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.d.ts",
    "scaffold/"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/stage-scaffold.mjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "node scripts/stage-scaffold.mjs && node scripts/run-tests.cjs",
    "test:integration": "node scripts/stage-scaffold.mjs && node scripts/run-tests.cjs \"\\.integration\\.test\\.js$\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.0"
  }
}
