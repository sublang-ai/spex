{
  "name": "spex-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Spex: the desktop app for running playbooks, and the @sublang/spex scaffold CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublang-ai/spex.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:migration": "node scripts/migration-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "node-gyp": "^12.4.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@33.4.11": true,
    "esbuild@0.28.2": true
  }
}
