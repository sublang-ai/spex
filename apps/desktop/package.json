{
  "name": "spex-desktop",
  "version": "0.8.0",
  "private": true,
  "description": "Spex — the desktop app for running playbooks",
  "author": {
    "name": "SubLang International"
  },
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublang-ai/spex.git",
    "directory": "apps/desktop"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run i18n:check && lingui compile --strict --typescript && tsc && node scripts/stage-ui.mjs",
    "start": "node ../../scripts/start-desktop.mjs",
    "test": "npm run i18n:check && node --test dist/*.test.js",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "node ../../scripts/i18n-check.mjs",
    "package": "npm run build && npm run rebuild:electron && electron-builder --mac zip --arm64",
    "rebuild:electron": "node scripts/rebuild-native.mjs electron",
    "rebuild:node": "node scripts/rebuild-native.mjs node"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@lingui/core": "^6.7.0",
    "@openai/codex-sdk": "*",
    "@opencode-ai/sdk": "*",
    "@sublang/slc": "^0.10.0",
    "@sublang/spex-core": "*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@types/node": "^26.4.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ai.sublang.spex",
    "productName": "Spex",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*.js",
      "preload.cjs",
      "!dist/**/*.test.js",
      "ui-dist/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
